---
// src/components/prasaka/PrasakaDasaDarma.astro
const darma = [
    { text: "Takwa kepada Tuhan Yang Maha Esa", morse: "−·−− ··−· −−·" },
    { text: "Cinta alam dan kasih sayang sesama manusia", morse: "−·−· ··−· −·−" },
    { text: "Patriot yang sopan dan kesatria", morse: "·−·−· −·−· −·−" },
    { text: "Patuh dan suka bermusyawarah", morse: "·−−· ·−−· −−·−" },
    { text: "Rela menolong dan tabah", morse: "·−·− ·−−· ·−−" },
    { text: "Rajin, terampil, dan gembira", morse: "−·−· ··−· −−·" },
    { text: "Hemat, cermat, dan bersahaja", morse: "···· ·−−· ·−−" },
    { text: "Disiplin, berani, dan setia", morse: "−··· ·−−· −·−" },
    { text: "Bertanggung jawab dan dapat dipercaya", morse: "−··· ·−−· −−·" },
    { text: "Suci dalam pikiran, perkataan, dan perbuatan", morse: "···− ·−−· ·−−" },
];
---

<section class="mb-28">
    <div class="text-center mb-14 reveal">
        <div class="flex items-center justify-center gap-3 mb-4">
            <div class="h-px w-10 rope-divider"></div>
            <p class="text-[11px] font-bold text-[#8b6914]/60 uppercase tracking-[0.4em]" style="font-family: 'Courier New', monospace;">Kode Kehormatan</p>
            <div class="h-px w-10 rope-divider"></div>
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight">
            Dasa <span class="text-gradient-earth">Darma</span>
        </h2>
        <p class="text-[#c3b091]/30 text-sm mt-3 max-w-xl mx-auto" style="font-family: 'Courier New', monospace;">
            Sepuluh nilai luhur pedoman Pramuka &mdash; decode sandi untuk membacanya.
        </p>
    </div>

    <!-- Logbook style list -->
    <div class="max-w-4xl mx-auto stagger-container">
        {darma.map((d, i) => (
            <div class="reveal group flex items-start gap-0 mb-1">
                <!-- Logbook line number -->
                <div class="w-12 shrink-0 pt-5 pb-5 flex flex-col items-center border-r border-[#8b6914]/15">
                    <div class="w-7 h-7 scout-badge rounded-full flex items-center justify-center">
                        <span class="text-[10px] font-black text-[#c4a77d]">{i + 1}</span>
                    </div>
                    {i < 9 && <div class="w-px flex-1 mt-2 treasure-path"></div>}
                </div>
                <!-- Entry content -->
                <div class="flex-1 glass-card-prasaka rounded-r-xl p-5 md:p-6 border-l-0 hover:border-[#8b6914]/30 transition-all duration-500 group-hover:bg-[#8b6914]/[0.03]">
                    <div class="flex flex-col md:flex-row md:items-center gap-3">
                        <p class="text-[#c3b091]/75 font-medium leading-snug group-hover:text-[#c3b091] transition-colors flex-1 text-sm md:text-base">
                            {d.text}
                        </p>
                        <!-- Sandi morse hover reveal -->
                        <div class="sandi-morse text-xs shrink-0 hidden md:block">
                            <span class="sandi-encoded">{d.morse}</span>
                            <span class="sandi-hidden text-[10px]">[terungkap]</span>
                        </div>
                    </div>
                    <!-- Mobile morse -->
                    <div class="sandi-morse text-[10px] mt-2 md:hidden">
                        <span class="sandi-encoded">{d.morse}</span>
                        <span class="sandi-hidden">[terungkap]</span>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <!-- Bottom rope seal -->
    <div class="flex justify-center mt-10">
        <div class="flex items-center gap-3">
            <div class="h-px w-16 rope-divider"></div>
            <div class="w-3 h-3 rounded-full bg-[#8b6914]/30 border border-[#8b6914]/40"></div>
            <div class="h-px w-16 rope-divider"></div>
        </div>
    </div>
</section>

---
// src/components/mecaknights/MecaKitReveal.astro
// Intro overlay: the whole PMR page is "sealed" inside a first aid kit.
// Click the box -> realistic latch release, weighted lid swing with bounce, light spill, then burst.
---

<div id="kit-overlay" class="kit-overlay">
    <!-- Background stars (pre-open atmosphere) -->
    <div class="kit-stars"></div>

    <!-- Core glow behind box (pulses before open) -->
    <div class="kit-core-glow" id="kit-core-glow"></div>

    <!-- The box -->
    <div id="kit-box" class="kit-scene" role="button" tabindex="0" aria-label="Buka kotak P3K">
        <div class="kit" id="kit">
            <!-- Lid assembly -->
            <div class="kit-lid" id="kit-lid">
                <div class="kit-lid-face">
                    <div class="kit-cross"><span></span><span></span></div>
                </div>
                <!-- Visible underside of lid (shown when open) -->
                <div class="kit-lid-bottom"></div>
            </div>

            <!-- Body -->
            <div class="kit-body">
                <div class="kit-inner-glow" id="kit-inner-glow"></div>
                <div class="kit-shine"></div>
                <span class="kit-label">FIRST AID</span>
            </div>

            <!-- Latch (animates independently) -->
            <div class="kit-latch" id="kit-latch"></div>

            <!-- Ground shadow -->
            <div class="kit-shadow" id="kit-shadow"></div>
        </div>

        <p class="kit-hint" id="kit-hint">
            <span class="kit-hint-pulse"></span>
            Klik kotak untuk membuka
        </p>
    </div>

    <!-- Explosion layers (populated by JS) -->
    <div class="kit-explosion" id="kit-explosion"></div>
</div>

<style is:global>
    /* === OVERLAY === */
    .kit-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: radial-gradient(ellipse at center, #0c0c10 0%, #050505 70%);
        transition: opacity 0.8s ease;
    }
    .kit-overlay.open {
        opacity: 0; pointer-events: none;
        transition-delay: 0.3s;
    }

    /* Stars */
    .kit-stars {
        position: absolute; inset: 0;
        background-image:
            radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4), transparent),
            radial-gradient(1px 1px at 80% 15%, rgba(255,255,255,0.3), transparent),
            radial-gradient(1px 1px at 30% 70%, rgba(255,255,255,0.35), transparent),
            radial-gradient(1px 1px at 60% 55%, rgba(255,255,255,0.25), transparent),
            radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.3), transparent),
            radial-gradient(1.5px 1.5px at 50% 10%, rgba(255,255,255,0.5), transparent),
            radial-gradient(1px 1px at 70% 35%, rgba(255,255,255,0.3), transparent);
        animation: kit-stars-drift 20s linear infinite;
    }
    @keyframes kit-stars-drift { to { transform: translateY(-20px); } }

    /* Core glow */
    .kit-core-glow {
        position: absolute;
        width: 300px; height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(237,28,36,0.3) 0%, transparent 70%);
        filter: blur(50px);
        animation: kit-glow-pulse 3s ease-in-out infinite;
        z-index: 0;
    }
    @keyframes kit-glow-pulse {
        0%, 100% { transform: scale(1); opacity: 0.6; }
        50% { transform: scale(1.2); opacity: 1; }
    }
    .kit-overlay.open .kit-core-glow {
        animation: kit-glow-explode 0.6s ease-out forwards;
    }
    @keyframes kit-glow-explode {
        0% { transform: scale(1); opacity: 1; }
        100% { transform: scale(4); opacity: 0; }
    }

    /* === BOX SCENE === */
    .kit-scene {
        perspective: 1000px;
        width: 240px; height: 220px;
        cursor: pointer; position: relative;
        z-index: 2;
    }
    .kit {
        position: relative;
        width: 240px; height: 130px;
        margin-top: 60px;
        transform-style: preserve-3d;
        animation: kit-bob 4s ease-in-out infinite;
        transition: transform 0.5s ease, filter 0.4s ease;
    }
    .kit-scene:hover .kit {
        transform: scale(1.06) translateY(-4px);
        filter: brightness(1.08);
    }
    @keyframes kit-bob {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        33% { transform: translateY(-14px) rotate(0.5deg); }
        66% { transform: translateY(-8px) rotate(-0.5deg); }
    }

    /* === BOX BODY === */
    .kit-body {
        position: absolute; bottom: 0; left: 0;
        width: 240px; height: 130px;
        border-radius: 16px;
        background: linear-gradient(150deg, #ef2b33 0%, #c81820 50%, #a0121a 100%);
        box-shadow:
            inset 0 -10px 25px rgba(0,0,0,0.4),
            inset 0 4px 12px rgba(255,255,255,0.15),
            0 24px 60px rgba(237,28,36,0.35);
        overflow: hidden;
        display: flex; align-items: flex-end; justify-content: center;
        transform-origin: bottom center;
    }
    .kit-inner-glow {
        position: absolute; inset: 0;
        background: radial-gradient(ellipse at center top, rgba(255,200,150,0.3), transparent 60%);
        opacity: 0;
        transition: opacity 0.5s ease;
    }
    .kit-scene:hover .kit-inner-glow { opacity: 0.4; }
    .kit-shine {
        position: absolute; inset: 0;
        background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,0.2) 48%, transparent 60%);
    }
    .kit-label {
        font-family: 'Outfit', sans-serif; font-weight: 700;
        letter-spacing: 0.35em; font-size: 13px;
        color: rgba(255,255,255,0.85);
        margin-bottom: 18px;
        text-shadow: 0 1px 3px rgba(0,0,0,0.4);
    }

    /* === LATCH === */
    .kit-latch {
        position: absolute;
        top: -8px; left: 50%;
        transform: translateX(-50%);
        width: 46px; height: 16px;
        border-radius: 4px;
        background: linear-gradient(#f4f4f2, #d8d8d8);
        box-shadow: 0 2px 6px rgba(0,0,0,0.35);
        z-index: 8;
        transform-origin: center bottom;
    }

    /* === LID === */
    .kit-lid {
        position: absolute;
        top: 0; left: 0;
        width: 240px; height: 58px;
        transform-origin: bottom center;
        transform: rotateX(0deg);
        transition: transform 1.1s cubic-bezier(0.34, 1.35, 0.55, 1);
        z-index: 5;
    }
    .kit-lid-face {
        position: absolute; inset: 0;
        border-radius: 16px 16px 4px 4px;
        background: linear-gradient(150deg, #ff3b43 0%, #d21c24 70%, #b0141c 100%);
        box-shadow: inset 0 4px 12px rgba(255,255,255,0.2), 0 6px 16px rgba(0,0,0,0.3);
        display: flex; align-items: center; justify-content: center;
        backface-visibility: hidden;
    }
    .kit-lid-bottom {
        position: absolute; inset: 0;
        border-radius: 16px 16px 4px 4px;
        background: linear-gradient(150deg, #c01820, #8a0f16);
        transform: rotateX(180deg);
        backface-visibility: hidden;
        box-shadow: inset 0 -4px 12px rgba(0,0,0,0.4);
    }
    .kit-cross { position: relative; width: 34px; height: 34px; }
    .kit-cross span {
        position: absolute; background: #fff; border-radius: 3px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.25);
    }
    .kit-cross span:first-child { width: 34px; height: 12px; top: 11px; left: 0; }
    .kit-cross span:last-child  { width: 12px; height: 34px; top: 0; left: 11px; }

    /* === GROUND SHADOW === */
    .kit-shadow {
        position: absolute;
        bottom: -18px; left: 50%;
        transform: translateX(-50%);
        width: 180px; height: 30px;
        border-radius: 50%;
        background: radial-gradient(ellipse, rgba(0,0,0,0.5), transparent 70%);
        filter: blur(8px);
    }

    /* === HINT TEXT === */
    .kit-hint {
        position: absolute; bottom: 10px; left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
        display: flex; align-items: center; gap: 10px;
        font-size: 11px; font-weight: 700;
        letter-spacing: 0.3em; text-transform: uppercase;
        color: rgba(237, 100, 110, 0.75);
        animation: kit-hint-breathe 3s ease-in-out infinite;
        transition: opacity 0.4s;
    }
    .kit-hint-pulse {
        width: 8px; height: 8px; border-radius: 50%;
        background: #ed1c24;
        box-shadow: 0 0 12px #ed1c24;
        animation: kit-hint-blink 1.4s ease-in-out infinite;
    }
    @keyframes kit-hint-breathe {
        0%, 100% { opacity: 0.4; transform: translateX(-50%) translateY(0); }
        50% { opacity: 1; transform: translateX(-50%) translateY(-3px); }
    }
    @keyframes kit-hint-blink {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.8); opacity: 0.4; }
    }

    /* === REALISTIC OPENING ANIMATIONS === */

    /* Latch: compress down, then spring up and vanish */
    @keyframes latch-spring {
        0%   { transform: translateX(-50%) translateY(0) scaleY(1); }
        12%  { transform: translateX(-50%) translateY(3px) scaleY(0.7); opacity: 1; }
        30%  { transform: translateX(-50%) translateY(-22px) scaleY(1.1); opacity: 1; }
        50%  { transform: translateX(-50%) translateY(-18px) scaleY(0.95) rotate(8deg); opacity: 1; }
        65%  { transform: translateX(-50%) translateY(-20px) scaleY(1.02) rotate(-3deg); opacity: 0.7; }
        100% { transform: translateX(-50%) translateY(-30px) scaleY(0.8) rotate(12deg); opacity: 0; }
    }

    /* Lid: fast swing open → overshoot → bounce back → settle */
    @keyframes lid-open {
        0%    { transform: rotateX(0deg); }
        8%    { transform: rotateX(4deg); }
        25%   { transform: rotateX(-120deg); }
        40%   { transform: rotateX(-158deg); }
        52%   { transform: rotateX(-146deg); }
        62%   { transform: rotateX(-152deg); }
        72%   { transform: rotateX(-149deg); }
        82%   { transform: rotateX(-151deg); }
        100%  { transform: rotateX(-150deg); }
    }

    /* Box body: rocks forward slightly when lid swings */
    @keyframes body-rock {
        0%   { transform: rotateX(0deg) translateY(0); }
        15%  { transform: rotateX(2deg) translateY(2px); }
        35%  { transform: rotateX(-1.5deg) translateY(-1px); }
        55%  { transform: rotateX(0.8deg) translateY(0.5px); }
        75%  { transform: rotateX(-0.3deg); }
        100% { transform: rotateX(0deg) translateY(0); }
    }

    /* Shadow: grows slightly when lid opens */
    @keyframes shadow-open {
        0%   { transform: translateX(-50%) scaleX(1); filter: blur(8px); }
        40%  { transform: translateX(-50%) scaleX(1.15); filter: blur(10px); }
        100% { transform: translateX(-50%) scaleX(1.3); filter: blur(12px); }
    }

    /* Inner glow ramps up as lid cracks */
    @keyframes glow-ramp {
        0%   { opacity: 0; }
        15%  { opacity: 0.15; }
        40%  { opacity: 0.6; }
        100% { opacity: 1; }
    }

    /* Kit fly-away after explosion */
    @keyframes kit-fly-away {
        0%   { transform: translateY(0) scale(1); opacity: 1; filter: brightness(1); }
        25%  { transform: translateY(-20px) scale(1.08); opacity: 1; filter: brightness(2); }
        100% { transform: translateY(-220px) scale(0.15); opacity: 0; filter: brightness(3) blur(8px); }
    }

    /* === EXPLOSION EFFECTS === */
    .kit-explosion {
        position: fixed; inset: 0;
        pointer-events: none; z-index: 10000;
    }
    .kit-ring {
        position: absolute; border-radius: 50%;
        border: 3px solid rgba(237, 28, 36, 0.6);
        transform: translate(-50%, -50%) scale(0); opacity: 0;
    }
    .kit-ring.animate {
        animation: ring-expand var(--ring-dur, 1s) var(--ring-ease, cubic-bezier(0.2, 0.8, 0.3, 1)) forwards;
        animation-delay: var(--ring-delay, 0s);
    }
    @keyframes ring-expand {
        0%   { transform: translate(-50%, -50%) scale(0); opacity: 0.9; border-width: 4px; }
        100% { transform: translate(-50%, -50%) scale(var(--ring-scale, 20)); opacity: 0; border-width: 0; }
    }
    .kit-flash-layer {
        position: absolute; inset: 0;
        background: radial-gradient(circle, rgba(255,255,255,0.95), rgba(255,200,150,0.4) 40%, transparent 70%);
        opacity: 0;
    }
    .kit-flash-layer.animate {
        animation: flash-pop 0.6s ease-out forwards;
    }
    @keyframes flash-pop {
        0%  { opacity: 0; transform: scale(0.5); }
        15% { opacity: 1; transform: scale(1.1); }
        100% { opacity: 0; transform: scale(1.5); }
    }
    .kit-ray {
        position: absolute; width: 4px; height: 0;
        background: linear-gradient(to top, rgba(237,28,36,0.7), rgba(255,200,150,0.3), transparent);
        transform-origin: bottom center; opacity: 0; border-radius: 2px;
    }
    .kit-ray.animate {
        animation: ray-shoot var(--ray-dur, 0.8s) var(--ray-ease, cubic-bezier(0.16, 1, 0.3, 1)) forwards;
        animation-delay: var(--ray-delay, 0s);
    }
    @keyframes ray-shoot {
        0%   { height: 0; opacity: 0; }
        20%  { opacity: 0.9; }
        100% { height: var(--ray-len, 300px); opacity: 0; }
    }
    .kit-particle {
        position: absolute; border-radius: 50%;
        pointer-events: none; will-change: transform, opacity;
    }

    /* Section flight */
    .kit-bursting {
        animation: section-fly var(--fly-dur, 1.4s) var(--fly-ease, cubic-bezier(0.34, 1.56, 0.42, 1)) forwards;
        animation-delay: var(--fly-delay, 0s);
    }
    @keyframes section-fly {
        0% {
            opacity: 0;
            transform: translate(var(--fly-x), var(--fly-y)) scale(0.04) rotate(var(--fly-rot));
            filter: blur(12px) brightness(2.5);
        }
        15% { opacity: 1; filter: blur(2px) brightness(1.5); }
        60% { filter: blur(0) brightness(1.1); }
        80% {
            transform: translate(calc(var(--fly-x) * -0.08), calc(var(--fly-y) * -0.08)) scale(1.03) rotate(0deg);
            filter: blur(0) brightness(1);
        }
        100% {
            opacity: 1;
            transform: translate(0, 0) scale(1) rotate(0deg);
            filter: blur(0) brightness(1);
        }
    }
    .kit-settled {}

    /* Screen shake */
    @keyframes kit-shake {
        0%, 100% { transform: translate(0, 0); }
        15% { transform: translate(-8px, 6px) rotate(-0.5deg); }
        30% { transform: translate(7px, -5px) rotate(0.4deg); }
        45% { transform: translate(-6px, -4px) rotate(-0.3deg); }
        60% { transform: translate(5px, 3px) rotate(0.2deg); }
        75% { transform: translate(-3px, -2px); }
        90% { transform: translate(2px, 1px); }
    }
    body.kit-shaking {
        animation: kit-shake 0.55s ease-in-out;
    }
</style>

<script>
    function initMecaKit() {
        const overlay = document.getElementById('kit-overlay');
        const box = document.getElementById('kit-box');
        const content = document.getElementById('meca-content');
        const explosion = document.getElementById('kit-explosion');
        const kit = document.getElementById('kit');
        const lid = document.getElementById('kit-lid');
        const latch = document.getElementById('kit-latch');
        const kitBody = box?.querySelector('.kit-body') as HTMLElement | null;
        const shadow = document.getElementById('kit-shadow');
        const innerGlow = document.getElementById('kit-inner-glow');
        const hint = document.getElementById('kit-hint');
        if (!overlay || !box || !content || !explosion || !kit || !lid || !latch || !kitBody || !shadow || !innerGlow || !hint) return;
        if (overlay.dataset.init === '1') return;
        overlay.dataset.init = '1';

        const prevOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';

        content.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));

        const sections = Array.from(content.children) as HTMLElement[];

        function packSections() {
            const vpX = window.innerWidth / 2;
            const vpY = window.innerHeight / 2;
            sections.forEach(sec => {
                const r = sec.getBoundingClientRect();
                const cx = r.left + r.width / 2;
                const cy = r.top + r.height / 2;
                const rot = (Math.random() * 80 - 40).toFixed(1);
                sec.style.transformOrigin = 'center center';
                sec.style.transition = 'none';
                sec.style.opacity = '0';
                sec.style.willChange = 'transform, opacity, filter';
                sec.style.transform =
                    `translate(${(vpX - cx).toFixed(0)}px, ${(vpY - cy).toFixed(0)}px) scale(0.04) rotate(${rot}deg)`;
                sec.style.filter = 'blur(12px) brightness(2.5)';
            });
        }
        requestAnimationFrame(() => requestAnimationFrame(packSections));

        /* ---- EXPLOSION EFFECTS ---- */
        function spawnExplosion(cx: number, cy: number) {
            explosion.innerHTML = '';

            const flash = document.createElement('div');
            flash.className = 'kit-flash-layer';
            explosion.appendChild(flash);
            requestAnimationFrame(() => flash.classList.add('animate'));

            const rings = [
                { size: 120, scale: 25, dur: '1.1s', delay: '0s', color: 'rgba(237,28,36,0.5)' },
                { size: 80, scale: 20, dur: '1.3s', delay: '0.06s', color: 'rgba(255,180,100,0.35)' },
                { size: 50, scale: 18, dur: '1s', delay: '0.12s', color: 'rgba(255,255,255,0.3)' },
            ];
            rings.forEach(cfg => {
                const ring = document.createElement('div');
                ring.className = 'kit-ring';
                ring.style.cssText =
                    `left:${cx}px;top:${cy}px;width:${cfg.size}px;height:${cfg.size}px;border-color:${cfg.color};--ring-scale:${cfg.scale};--ring-dur:${cfg.dur};--ring-delay:${cfg.delay}`;
                explosion.appendChild(ring);
                requestAnimationFrame(() => ring.classList.add('animate'));
            });

            for (let i = 0; i < 14; i++) {
                const angle = (360 / 14) * i + (Math.random() * 10 - 5);
                const ray = document.createElement('div');
                ray.className = 'kit-ray';
                const len = 150 + Math.random() * 250;
                ray.style.cssText =
                    `left:${cx}px;top:${cy}px;transform:rotate(${angle}deg);--ray-len:${len}px;--ray-dur:${0.5 + Math.random() * 0.5}s;--ray-delay:${0.05 + Math.random() * 0.2}s`;
                explosion.appendChild(ray);
                requestAnimationFrame(() => ray.classList.add('animate'));
            }

            const layers = [
                { count: 40, minV: 280, maxV: 600, minSize: 2, maxSize: 5, colors: ['#ed1c24', '#ff6b6b', '#ff3b43', '#ff8a8a'], gravity: 200, life: 1.2 },
                { count: 25, minV: 150, maxV: 380, minSize: 5, maxSize: 12, colors: ['#ff4444', '#ffaa44', '#ffddaa'], gravity: 120, life: 1.6 },
                { count: 15, minV: 80, maxV: 200, minSize: 10, maxSize: 22, colors: ['rgba(237,28,36,0.5)', 'rgba(255,150,80,0.4)'], gravity: 50, life: 2.2 },
            ];
            layers.forEach(layer => {
                for (let i = 0; i < layer.count; i++) {
                    const el = document.createElement('div');
                    el.className = 'kit-particle';
                    const size = layer.minSize + Math.random() * (layer.maxSize - layer.minSize);
                    const angle = Math.random() * Math.PI * 2;
                    const velocity = layer.minV + Math.random() * (layer.maxV - layer.minV);
                    const color = layer.colors[Math.floor(Math.random() * layer.colors.length)];
                    el.style.cssText =
                        `left:${cx}px;top:${cy}px;width:${size}px;height:${size}px;background:${color};box-shadow:0 0 ${size}px ${color};opacity:1`;
                    explosion.appendChild(el);

                    const vx = Math.cos(angle) * velocity;
                    const vy = Math.sin(angle) * velocity;
                    const start = performance.now();
                    (function tick(now: number) {
                        const t = (now - start) / 1000;
                        if (t > layer.life) { el.remove(); return; }
                        const p = t / layer.life;
                        const ease = 1 - Math.pow(1 - p, 3);
                        const x = vx * t;
                        const y = vy * t + 0.5 * layer.gravity * t * t;
                        el.style.transform = `translate(${x.toFixed(1)}px,${y.toFixed(1)}px) scale(${(1 - ease * 0.6).toFixed(2)})`;
                        el.style.opacity = (1 - ease).toFixed(2);
                        requestAnimationFrame(tick);
                    })(start);
                }
            });
        }

        /* ---- OPEN KIT ---- */
        let opened = false;
        function openKit() {
            if (opened) return;
            opened = true;

            // Hide hint
            hint.style.opacity = '0';

            // Disable hover effects
            box.style.pointerEvents = 'none';

            // Hold current bob position (stop animation without jump)
            const kitComputed = getComputedStyle(kit).transform;
            kit.style.animation = 'none';
            if (kitComputed && kitComputed !== 'none') {
                kit.style.transform = kitComputed;
            }

            // --- PHASE 1: Latch spring (0ms) ---
            latch.style.animation = 'latch-spring 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) forwards';

            // --- PHASE 2: Lid swings open (200ms) ---
            setTimeout(() => {
                lid.style.animation = 'lid-open 1.3s cubic-bezier(0.22, 1, 0.36, 1) forwards';
            }, 200);

            // --- PHASE 3: Box body rocks + inner glow ramps (same time as lid) ---
            setTimeout(() => {
                kitBody.style.transformOrigin = 'bottom center';
                kitBody.style.animation = 'body-rock 0.9s ease-out forwards';
                innerGlow.style.animation = 'glow-ramp 1.2s ease-out forwards';
                shadow.style.animation = 'shadow-open 1.2s ease-out forwards';
            }, 250);

            // --- PHASE 4: Explosion + burst (1000ms after click) ---
            setTimeout(() => {
                overlay.classList.add('open');
                document.body.style.overflow = prevOverflow;

                const boxRect = box.getBoundingClientRect();
                const cx = boxRect.left + boxRect.width / 2;
                const cy = boxRect.top + boxRect.height * 0.35; // light comes from the lid gap, not the center

                spawnExplosion(cx, cy);
                document.body.classList.add('kit-shaking');
                setTimeout(() => document.body.classList.remove('kit-shaking'), 500);

                // Fly the whole kit up and away
                kit.style.animation = 'kit-fly-away 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards';

                // Burst sections
                const vpX = window.innerWidth / 2;
                const vpY = window.innerHeight / 2;
                const sorted = sections.map(sec => {
                    const r = sec.getBoundingClientRect();
                    const sx = r.left + r.width / 2;
                    const sy = r.top + r.height / 2;
                    const dist = Math.sqrt((sx - vpX) ** 2 + (sy - vpY) ** 2);
                    return { sec, dist };
                }).sort((a, b) => a.dist - b.dist);

                sorted.forEach(({ sec }, rank) => {
                    const r = sec.getBoundingClientRect();
                    const sx = r.left + r.width / 2;
                    const sy = r.top + r.height / 2;
                    const dx = sx - vpX;
                    const dy = sy - vpY;
                    const angle = Math.atan2(dy, dx);
                    const pushX = Math.cos(angle) * (60 + Math.random() * 40);
                    const pushY = Math.sin(angle) * (60 + Math.random() * 40);
                    const flyX = (vpX - sx) + pushX;
                    const flyY = (vpY - sy) + pushY;
                    const rot = (Math.random() * 16 - 8).toFixed(1);
                    const delay = 0.08 + rank * 0.12;
                    const dur = 1.2 + Math.random() * 0.3;

                    sec.style.setProperty('--fly-x', `${flyX.toFixed(0)}px`);
                    sec.style.setProperty('--fly-y', `${flyY.toFixed(0)}px`);
                    sec.style.setProperty('--fly-rot', `${rot}deg`);
                    sec.style.setProperty('--fly-delay', `${delay.toFixed(2)}s`);
                    sec.style.setProperty('--fly-dur', `${dur.toFixed(2)}s`);
                    sec.classList.add('kit-bursting');

                    setTimeout(() => {
                        sec.style.transition = '';
                        sec.style.transform = '';
                        sec.style.opacity = '';
                        sec.style.filter = '';
                        sec.style.transformOrigin = '';
                        sec.style.willChange = '';
                        sec.style.removeProperty('--fly-x');
                        sec.style.removeProperty('--fly-y');
                        sec.style.removeProperty('--fly-rot');
                        sec.style.removeProperty('--fly-delay');
                        sec.style.removeProperty('--fly-dur');
                        sec.classList.remove('kit-bursting');
                        sec.classList.add('kit-settled');
                    }, (delay + dur) * 1000 + 200);
                });

            }, 1000);

            // Remove overlay from DOM
            setTimeout(() => { overlay.style.display = 'none'; }, 1600);
        }

        box.addEventListener('click', openKit);
        box.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openKit(); }
        });
        window.addEventListener('resize', () => { if (!opened) packSections(); });
    }

    document.addEventListener('DOMContentLoaded', initMecaKit);
    document.addEventListener('astro:page-load', initMecaKit);
</script>

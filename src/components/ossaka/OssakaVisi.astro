---
// src/components/ossaka/OssakaVisi.astro
const pillars = [
    { label: "Berintegritas", icon: "shield" },
    { label: "Beradab", icon: "heart" },
    { label: "Aspiratif", icon: "message-circle" },
    { label: "Berakhlak", icon: "sun" },
    { label: "Disiplin", icon: "clock" },
    { label: "Bertanggung Jawab", icon: "check-circle" },
];
---

<!-- Split layout: Visi left, Pillars right -->
<div class="grid lg:grid-cols-[1.2fr_1fr] gap-12 lg:gap-16 items-start">
    <!-- Left: Visi document card -->
    <div class="reveal">
        <!-- Section label -->
        <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-10 gold-line"></div>
            <p class="text-[11px] font-bold text-indigo-300/30 uppercase tracking-[0.4em]">Visi</p>
            <div class="h-px w-10 gold-line"></div>
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-8">
            Arah <span class="text-gradient-executive">Perjuangan</span> Kami
        </h2>

        <!-- Clipboard document -->
        <div class="relative">
            <div class="flex mb-0">
                <div class="clipboard-tab flex items-center gap-2">
                    <span class="text-[9px] font-bold text-indigo-300/20 uppercase tracking-[0.3em]">Dokumen Resmi</span>
                    <span class="w-1 h-1 rounded-full bg-amber-500/40"></span>
                    <span class="text-[9px] font-bold text-amber-400/30 uppercase tracking-[0.3em]">No. 001/OSIS/VISI</span>
                </div>
            </div>
            <div class="glass-card-ossaka celestial-glow rounded-b-2xl rounded-t-none p-8 md:p-10 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-12 h-12 border-t border-l border-indigo-500/10 rounded-tl-2xl"></div>
                <div class="absolute bottom-0 right-0 w-12 h-12 border-b border-r border-amber-500/10 rounded-br-2xl"></div>
                <div class="absolute top-0 right-0 w-40 h-40 bg-indigo-600/5 blur-[60px] rounded-full"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[6rem] font-black text-indigo-500/[0.02] select-none pointer-events-none">OSIS</div>
                <div class="absolute inset-0 doc-rules opacity-30 pointer-events-none"></div>

                <p class="relative text-lg md:text-xl font-light leading-relaxed md:leading-[1.6] text-indigo-100/45">
                    Mewujudkan OSIS SMP ABBS Surakarta menjadi organisasi yang
                    <span class="font-bold text-gradient-executive">berintegritas, beradab, dan aspiratif</span>,
                    serta menjadi wadah pengembangan potensi siswa yang
                    <span class="font-bold text-gradient-executive">berakhlak, disiplin, bertanggung jawab</span>,
                    dan mampu menjadi teladan bagi seluruh warga sekolah.
                </p>

                <div class="flex justify-end mt-6">
                    <div class="official-seal">
                        <span class="text-[7px] font-black text-amber-400/25 uppercase tracking-widest text-center leading-tight">OSIS<br>ABBS</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Value pillars — 2-col stacked -->
    <div class="reveal">
        <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-10 gold-line"></div>
            <p class="text-[11px] font-bold text-indigo-300/30 uppercase tracking-[0.4em]">Nilai-Nilai</p>
            <div class="h-px w-10 gold-line"></div>
        </div>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-8">
            Pilar <span class="text-gradient-executive">Kami</span>
        </h2>

        <div class="grid grid-cols-2 gap-3">
            {pillars.map((p, i) => (
                <div class="reveal group glass-card-ossaka celestial-glow rounded-xl p-4 flex items-center gap-3 hover:-translate-y-0.5 transition-all duration-400" style={`transition-delay: ${i * 50}ms`}>
                    <div class="relative shrink-0">
                        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-indigo-500/15 to-indigo-600/8 border border-indigo-500/15 flex items-center justify-center text-indigo-300/50 group-hover:text-amber-300/70 group-hover:border-amber-500/20 transition-all duration-300">
                            <i data-feather={p.icon} class="w-4 h-4"></i>
                        </div>
                        <div class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-amber-500/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>
                    <span class="text-[10px] font-bold text-indigo-200/30 uppercase tracking-wider group-hover:text-indigo-200/55 transition-colors leading-tight">{p.label}</span>
                </div>
            ))}
        </div>
    </div>
</div>

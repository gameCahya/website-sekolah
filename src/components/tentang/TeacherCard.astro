---

interface Props {
  name: string;
  position: string;
  subject?: string;
  photo?: string;
  description?: string;
}

const {
  name,
  position,
  subject,
  photo,
  description,
} = Astro.props;
---

<div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden border border-slate-200/80 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow duration-300">
    <div class="h-56 overflow-hidden bg-slate-50 dark:bg-gray-800">
      {photo ? (
        <img 
          src={photo} 
          alt={name}
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-16 h-16 text-slate-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
      )}
    </div>
    
    <div class="p-5">
      <span class="inline-block px-2.5 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wider bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400 mb-2">
        {position}
      </span>
      <h3 class="text-lg font-bold tracking-tight text-slate-900 dark:text-white mb-1">
        {name}
      </h3>
      
      {subject && (
        <div class="text-sm text-slate-400 dark:text-gray-500">
          {subject}
        </div>
      )}
      
      {description && (
        <p class="text-slate-600 dark:text-gray-400 text-sm mt-3 leading-relaxed line-clamp-2">
          {description}
        </p>
      )}
    </div>
</div>
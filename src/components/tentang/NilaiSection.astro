---
interface Nilai {
  icon: string;
  title: string;
  description: string;
  colorFrom: string;
  colorTo: string;
  borderColor: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  values?: Nilai[];
}

const {
  title = 'Nilai-Nilai Kami',
  subtitle = 'Prinsip-prinsip yang menjadi fondasi pendidikan di ABBS Surakarta',
    values = [
    {
      icon: 'heart',
      title: 'Religius',
      description: 'Menanamkan nilai-nilai keislaman dalam setiap aspek kehidupan dan pembelajaran',
      colorFrom: 'from-primary-50',
      colorTo: 'to-primary-100',
      borderColor: 'border-primary-200 dark:border-primary-900',
    },
    {
      icon: 'star',
      title: 'Prestasi',
      description: 'Mendorong siswa untuk mencapai keunggulan akademik dan non-akademik',
      colorFrom: 'from-accent-50',
      colorTo: 'to-accent-100',
      borderColor: 'border-accent-200 dark:border-accent-900',
    },
    {
      icon: 'users',
      title: 'Integritas',
      description: 'Membangun karakter jujur, bertanggung jawab, dan dapat dipercaya',
      colorFrom: 'from-secondary-50',
      colorTo: 'to-secondary-100',
      borderColor: 'border-secondary-200 dark:border-secondary-900',
    },
    {
      icon: 'lightbulb',
      title: 'Inovatif',
      description: 'Menerapkan metode pembelajaran modern dan kreatif yang efektif',
      colorFrom: 'from-primary-50',
      colorTo: 'to-primary-100',
      borderColor: 'border-primary-200 dark:border-primary-900',
    },
    {
      icon: 'globe',
      title: 'Global',
      description: 'Mempersiapkan siswa dengan wawasan dan kemampuan berkelas internasional',
      colorFrom: 'from-accent-50',
      colorTo: 'to-accent-100',
      borderColor: 'border-accent-200 dark:border-accent-900',
    },
    {
      icon: 'heart',
      title: 'Peduli',
      description: 'Menumbuhkan empati dan kepedulian terhadap sesama dan lingkungan',
      colorFrom: 'from-secondary-50',
      colorTo: 'to-secondary-100',
      borderColor: 'border-secondary-200 dark:border-secondary-900',
    },
  ]
} = Astro.props;
---

<section class="py-12 md:py-20 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">
        {title}
      </h2>
      <p class="text-slate-600 dark:text-gray-400 max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {values.map((nilai) => (
        <div class={`bg-gradient-to-br ${nilai.colorFrom} ${nilai.colorTo} dark:from-gray-900 dark:to-gray-800 rounded-xl p-6 border ${nilai.borderColor} shadow-sm hover:shadow-md transition-shadow duration-300`}>
          <div class="text-4xl mb-4"><i data-feather={nilai.icon} class="inline-block w-8 h-8" /></div>
          <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white mb-3">
            {nilai.title}
          </h3>
          <p class="text-slate-600 dark:text-gray-400">
            {nilai.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
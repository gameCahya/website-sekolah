---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="page active" id={id}>
  <div class="front border-2 border-[#004d4d] flex flex-col items-center justify-center p-12 text-center relative overflow-hidden" style="background: linear-gradient(160deg, #001a1a 0%, #002b2b 40%, #003838 100%);">
    <div class="absolute inset-0 opacity-[0.07] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/leather.png');"></div>
    
    <!-- Molecular lattice background -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <!-- Benzene ring (hexagonal molecular structure) -->
      <svg class="absolute top-[12%] left-[10%] w-28 h-28 opacity-[0.06]" viewBox="0 0 100 100" fill="none" stroke="#14b8a6" stroke-width="1">
        <polygon points="50,15 80,32 80,68 50,85 20,68 20,32" />
        <line x1="35" y1="23" x2="35" y2="39" stroke-dasharray="3 2"/>
        <line x1="65" y1="23" x2="65" y2="39" stroke-dasharray="3 2"/>
        <line x1="50" y1="61" x2="50" y2="77" stroke-dasharray="3 2"/>
        <circle cx="50" cy="15" r="3" fill="#14b8a6" opacity="0.3"/>
        <circle cx="80" cy="32" r="3" fill="#14b8a6" opacity="0.3"/>
        <circle cx="80" cy="68" r="3" fill="#14b8a6" opacity="0.3"/>
        <circle cx="50" cy="85" r="3" fill="#14b8a6" opacity="0.3"/>
        <circle cx="20" cy="68" r="3" fill="#14b8a6" opacity="0.3"/>
        <circle cx="20" cy="32" r="3" fill="#14b8a6" opacity="0.3"/>
      </svg>

      <!-- Atom with electron orbits -->
      <svg class="absolute bottom-[15%] right-[12%] w-32 h-32 opacity-[0.05]" viewBox="0 0 120 120" fill="none" stroke="#10b981" stroke-width="0.8">
        <ellipse cx="60" cy="60" rx="50" ry="18" transform="rotate(0 60 60)"/>
        <ellipse cx="60" cy="60" rx="50" ry="18" transform="rotate(60 60 60)"/>
        <ellipse cx="60" cy="60" rx="50" ry="18" transform="rotate(120 60 60)"/>
        <circle cx="60" cy="60" r="5" fill="#10b981" opacity="0.4"/>
        <circle cx="110" cy="60" r="3" fill="#10b981" opacity="0.3"/>
        <circle cx="35" cy="17" r="3" fill="#10b981" opacity="0.3"/>
        <circle cx="35" cy="103" r="3" fill="#10b981" opacity="0.3"/>
      </svg>

      <!-- E=mc² formula whisper -->
      <div class="absolute top-[20%] right-[15%] font-hand text-[11px] text-teal-400/[0.08] pointer-events-none rotate-6 select-none">
        E = mc²
      </div>
      <!-- F=ma whisper -->
      <div class="absolute bottom-[25%] left-[18%] font-hand text-[10px] text-emerald-400/[0.07] pointer-events-none -rotate-3 select-none">
        F = ma
      </div>

      <!-- Floating particles -->
      <div class="absolute top-[15%] left-[20%] w-2 h-2 rounded-full bg-teal-400/30 animate-pulse" style="animation-duration:3s;"></div>
      <div class="absolute top-[25%] right-[30%] w-1.5 h-1.5 rounded-full bg-emerald-300/20 animate-pulse" style="animation-duration:4s; animation-delay:1s;"></div>
      <div class="absolute top-[60%] left-[15%] w-1 h-1 rounded-full bg-teal-200/25 animate-pulse" style="animation-duration:5s; animation-delay:0.5s;"></div>
      <div class="absolute top-[70%] right-[20%] w-2.5 h-2.5 rounded-full bg-emerald-400/15 animate-pulse" style="animation-duration:3.5s; animation-delay:2s;"></div>
      <div class="absolute top-[40%] left-[60%] w-1 h-1 rounded-full bg-teal-300/20 animate-pulse" style="animation-duration:6s; animation-delay:1.5s;"></div>

      <!-- Connection lines -->
      <svg class="absolute inset-0 w-full h-full opacity-[0.03]" xmlns="http://www.w3.org/2000/svg">
        <line x1="20%" y1="15%" x2="60%" y2="40%" stroke="#14b8a6" stroke-width="0.5"/>
        <line x1="60%" y1="40%" x2="80%" y2="50%" stroke="#10b981" stroke-width="0.5"/>
        <line x1="15%" y1="60%" x2="45%" y2="80%" stroke="#14b8a6" stroke-width="0.5"/>
      </svg>
    </div>

    <!-- Inner border -->
    <div class="absolute inset-6 border border-teal-500/15 pointer-events-none"></div>
    <div class="absolute top-6 left-6 w-5 h-5 border-t-2 border-l-2 border-teal-400/30"></div>
    <div class="absolute top-6 right-6 w-5 h-5 border-t-2 border-r-2 border-teal-400/30"></div>
    <div class="absolute bottom-6 left-6 w-5 h-5 border-b-2 border-l-2 border-teal-400/30"></div>
    <div class="absolute bottom-6 right-6 w-5 h-5 border-b-2 border-r-2 border-teal-400/30"></div>

    <!-- Main Content -->
    <div class="relative z-10 flex flex-col items-center w-full">
      <div class="relative mb-8">
        <div class="absolute inset-0 bg-teal-500/10 rounded-full blur-2xl scale-150 animate-pulse" style="animation-duration:4s;"></div>
        <img src="/communities/sinaps.png" alt="SINAPS Logo" class="w-40 mb-0 drop-shadow-[0_0_30px_rgba(20,184,166,0.25)] filter brightness-110 relative z-10" />
      </div>
      
      <h1 class="text-6xl font-serif font-black text-transparent bg-clip-text bg-gradient-to-b from-teal-50 via-teal-300 to-teal-500 tracking-[0.15em] mb-2 uppercase">Sinaps</h1>
      <p class="text-teal-400/60 font-serif italic text-[11px] tracking-[0.3em] mb-8">Scientific &amp; Intellectual Squad</p>
      
      <!-- Decorative divider with atom -->
      <div class="flex items-center justify-center gap-4 mb-8 w-full">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-teal-500/30"></div>
        <svg class="w-5 h-5 text-teal-400/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="3"/>
          <ellipse cx="12" cy="12" rx="10" ry="4"/>
          <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/>
          <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>
        </svg>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-teal-500/30"></div>
      </div>

      <!-- Subject badges -->
      <div class="flex items-center gap-3 mb-8">
        <span class="px-3 py-1 border border-teal-500/20 rounded text-[9px] font-serif text-teal-300/50 tracking-widest uppercase">Matematika</span>
        <span class="w-1 h-1 rounded-full bg-teal-500/30"></span>
        <span class="px-3 py-1 border border-teal-500/20 rounded text-[9px] font-serif text-teal-300/50 tracking-widest uppercase">Fisika</span>
        <span class="w-1 h-1 rounded-full bg-teal-500/30"></span>
        <span class="px-3 py-1 border border-teal-500/20 rounded text-[9px] font-serif text-teal-300/50 tracking-widest uppercase">Biologi</span>
        <span class="w-1 h-1 rounded-full bg-teal-500/30"></span>
        <span class="px-3 py-1 border border-teal-500/20 rounded text-[9px] font-serif text-teal-300/50 tracking-widest uppercase">IPS</span>
      </div>
      
      <!-- Tagline -->
      <p class="text-teal-200/20 text-[10px] font-serif italic max-w-[280px] leading-relaxed mb-4">"Di mana rasa ingin bertemu kemenangan."</p>
      
      <!-- Open button -->
      <button onclick="window.flipPage(1)" class="group relative px-14 py-4 bg-transparent cursor-pointer overflow-hidden transition-all hover:scale-105 active:scale-95">
        <div class="absolute inset-0 border border-teal-500/30 group-hover:border-teal-300/60 transition-all duration-500"></div>
        <div class="absolute inset-0 bg-teal-500/5 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
        <span class="relative z-10 text-teal-200/80 text-[11px] font-serif italic tracking-[0.3em] group-hover:text-white uppercase transition-colors duration-300">Open Journal</span>
      </button>
    </div>

    <div class="absolute top-0 left-0 w-10 h-full bg-gradient-to-r from-black/60 via-black/20 to-transparent pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-full h-8 bg-gradient-to-t from-black/30 to-transparent pointer-events-none"></div>
  </div>

  <div class="back border-r border-black/40 shadow-inner relative overflow-hidden" style="background: linear-gradient(160deg, #001818 0%, #001f1f 100%);">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/leather.png');"></div>
    <div class="p-16 h-full flex flex-col items-center justify-center text-center relative">
      <div class="relative mb-8">
        <div class="w-36 h-36 border border-teal-500/8 rounded-full flex items-center justify-center">
          <div class="w-28 h-28 border border-dashed border-teal-500/5 rounded-full flex items-center justify-center">
            <img src="/communities/sinaps.png" class="w-16 grayscale opacity-[0.08]" />
          </div>
        </div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-teal-400/30 rounded-full animate-pulse" style="animation-duration:3s;"></div>
      </div>
      <p class="text-teal-500/15 text-[9px] font-serif tracking-[0.5em] uppercase">Official Archive</p>
      <p class="text-teal-500/10 text-[8px] font-serif tracking-[0.4em] uppercase mt-2">Vol. 2024 — 2025</p>
    </div>
    <div class="absolute top-0 right-0 w-10 h-full bg-gradient-to-l from-black/40 via-black/10 to-transparent pointer-events-none"></div>
  </div>
</div>

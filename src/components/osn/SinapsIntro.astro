---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="page" id={id}>
  <div class="front bg-slate-50 border-l border-slate-300">
    <div class="p-14 h-full flex flex-col relative">
      <!-- Coffee ring -->
      <div class="absolute -top-6 right-12 w-24 h-24 border-[6px] border-amber-900/[0.04] rounded-full pointer-events-none rotate-12"></div>
      <!-- Page number -->
      <div class="absolute bottom-4 right-6 text-[9px] font-serif text-slate-300 italic">— 2 —</div>

      <div class="flex items-end gap-3 border-b-2 border-slate-200 pb-3 mb-5">
        <h2 class="text-3xl font-serif text-slate-800 font-bold">Apa itu OSN?</h2>
        <span class="text-[9px] font-hand text-amber-700/40 mb-1 rotate-[-2deg] inline-block">wajib baca!</span>
      </div>
      
      <div class="prose prose-slate prose-sm overflow-y-auto font-serif space-y-3 flex-1">
        <p class="text-slate-600 leading-relaxed text-[12px]">
          Olimpiade Sains Nasional (OSN) adalah kompetisi sains tingkat nasional bagi siswa SMP/MTs yang diselenggarakan oleh <span class="bg-teal-100/60 px-1 rounded font-bold">Pusat Prestasi Nasional (Puspresnas)</span>.
        </p>
        <p class="text-slate-600 leading-relaxed text-[12px]">
          OSN menjadi ajang pembinaan generasi muda untuk mengembangkan bakat, minat, dan kemampuan di bidang sains guna membangun daya saing bangsa.
        </p>

        <!-- Stats boxes -->
        <div class="grid grid-cols-2 gap-3 mt-4">
          <div class="bg-teal-50/80 p-3 rounded-lg border border-teal-100 text-center">
            <p class="text-xl font-black text-teal-700 font-serif">34</p>
            <p class="text-[9px] text-teal-600/70 uppercase tracking-wider">Provinsi</p>
          </div>
          <div class="bg-emerald-50/80 p-3 rounded-lg border border-emerald-100 text-center">
            <p class="text-xl font-black text-emerald-700 font-serif">500+</p>
            <p class="text-[9px] text-emerald-600/70 uppercase tracking-wider">Peserta Nasional</p>
          </div>
        </div>

        <!-- Highlighted box -->
        <div class="relative mt-3 p-4 bg-teal-50/80 border border-teal-100 rounded-lg">
          <div class="absolute -top-2 left-4 px-2 bg-slate-50 text-[8px] font-bold text-teal-600 uppercase tracking-widest">Tujuan</div>
          <p class="text-[11px] text-teal-800 italic font-serif leading-relaxed">Membina siswa berprestasi untuk mengharumkan nama bangsa di ajang Internasional.</p>
        </div>
      </div>

      <div class="mt-2 flex justify-end">
        <button onclick="window.flipPage(2)" class="text-xs font-serif italic text-teal-700 hover:text-teal-900 transition-colors flex items-center gap-2">Next Page <i data-feather="arrow-right" class="w-4 h-4"></i></button>
      </div>
    </div>
  </div>

  <div class="back bg-slate-50 border-r border-slate-300 shadow-inner">
    <div class="p-14 flex flex-col h-full relative">
      <div class="absolute bottom-4 left-6 text-[9px] font-serif text-slate-300 italic">— 3 —</div>

      <div class="flex items-end gap-3 border-b border-slate-200 pb-3 mb-5">
        <h2 class="text-2xl font-black text-[#004d4d] uppercase tracking-tight">Jenjang Kompetisi</h2>
        <div class="h-px flex-1 bg-gradient-to-r from-teal-200 to-transparent"></div>
      </div>
      
      <div class="space-y-4 font-serif flex-1">
        <p class="text-[12px] text-slate-600 leading-relaxed">
          Setiap tahun, ribuan siswa dari seluruh Indonesia bersaing untuk menjadi yang terbaik.
        </p>

        <!-- Competition path -->
        <div class="bg-[#003333]/[0.03] p-5 border border-teal-100 rounded-xl">
          <h4 class="text-[9px] font-bold text-[#004d4d] uppercase tracking-widest mb-4">Jalur Kompetisi:</h4>
          <div class="flex flex-col gap-0 text-xs text-teal-800 font-serif">
            <div class="flex items-center gap-3 py-2">
              <div class="w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center shrink-0">
                <span class="text-[10px] font-bold text-teal-600">1</span>
              </div>
              <div>
                <p class="font-bold text-teal-900">OSN-K (Kabupaten/Kota)</p>
                <p class="text-[10px] text-teal-600/70">Tahap awal seleksi</p>
              </div>
            </div>
            <div class="ml-4 w-px h-3 bg-teal-200"></div>
            <div class="flex items-center gap-3 py-2">
              <div class="w-8 h-8 rounded-full bg-teal-200 flex items-center justify-center shrink-0">
                <span class="text-[10px] font-bold text-teal-700">2</span>
              </div>
              <div>
                <p class="font-bold text-teal-900">OSN-P (Provinsi)</p>
                <p class="text-[10px] text-teal-600/70">Seleksi tingkat provinsi</p>
              </div>
            </div>
            <div class="ml-4 w-px h-3 bg-teal-200"></div>
            <div class="flex items-center gap-3 py-2">
              <div class="w-8 h-8 rounded-full bg-teal-500 flex items-center justify-center shrink-0 shadow-md shadow-teal-500/20">
                <span class="text-[10px] font-bold text-white">3</span>
              </div>
              <div>
                <p class="font-bold text-teal-900">OSN Nasional</p>
                <p class="text-[10px] text-teal-600/70">Kompetisi tingkat nasional</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Handwritten note -->
        <div class="rotate-[-1deg] bg-amber-50 p-4 shadow-sm border border-amber-100 mt-2">
          <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-10 h-2.5 bg-slate-300/20 rounded-sm"></div>
          <p class="font-hand text-[11px] text-amber-800/70">Persiapan harus dimatur dari jauh hari!</p>
        </div>
      </div>

      <div class="mt-2 flex justify-start">
        <button onclick="window.flipPage(-2)" class="text-xs font-serif italic text-teal-700 hover:text-teal-900 transition-colors flex items-center gap-2"><i data-feather="arrow-left" class="w-4 h-4"></i> Back Page</button>
      </div>
    </div>
  </div>
</div>

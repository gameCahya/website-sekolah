---
---


<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-7xl mx-auto py-12">
    <!-- Module 01: Core Protocol (Latar Belakang & Visi) -->
    <div class="lg:col-span-8 group">
        <div class="border border-[#00f2ff]/30 p-8 relative bg-[#001226]/60 backdrop-blur-md hover:border-[#00f2ff] transition-all shadow-[inset_0_0_30px_rgba(0,242,255,0.05)] h-full">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase tracking-widest">
                Module_01 // Core_Foundation
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-4">
                <div>
                    <h2 class="text-xs font-bold mb-4 text-[#00f2ff] opacity-50 tracking-[0.2em] uppercase">
                        // Latar Belakang
                    </h2>
                    <p class="text-sm leading-relaxed text-gray-300">
                        Perkembangan teknologi menuntut siswa tidak hanya memahami teori, tetapi juga kemampuan praktis dan inovatif. <span class="text-[#00f2ff]">The Tinkers</span> hadir sebagai wadah terstruktur untuk pengembangan ide dan persiapan kompetisi IT secara optimal.
                    </p>
                </div>
                <div>
                    <h2 class="text-xs font-bold mb-4 text-[#00f2ff] opacity-50 tracking-[0.2em] uppercase">
                        // Visi Utama
                    </h2>
                    <div class="border-l-2 border-[#00f2ff] pl-4 italic text-sm md:text-base text-white">
                        "Menjadi wadah unggulan bagi siswa dalam mengembangkan keterampilan teknologi, inovasi, dan kreativitas untuk menghasilkan karya yang kompetitif di tingkat nasional maupun internasional."
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Module 02: Strategic Objectives -->
    <div class="lg:col-span-4">
        <div class="border border-[#00f2ff]/30 p-8 bg-[#00f2ff]/5 relative h-full">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase">
                Module_02 // Objectives
            </div>
            <h3 class="text-xs font-bold mb-6 mt-4 text-[#00f2ff] tracking-widest uppercase">
                // Tujuan Strategis
            </h3>
            <ul class="space-y-4">
                {
                    [
                        "Kreativitas & Inovasi Siswa",
                        "Persiapan Lomba IT Terstruktur",
                        "Project-Based Learning Culture",
                        "Teamwork & Problem Solving",
                    ].map((item, index) => (
                        <li class="flex items-center gap-3 text-xs">
                            <span class="text-[#00f2ff] font-bold">
                                0{index + 1}
                            </span>
                            <span class="text-gray-300 uppercase tracking-tighter">
                                {item}
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <!-- Module 04: Progression System (Levels) -->
    <div class="lg:col-span-12">
        <div class="border border-[#00f2ff]/30 p-8 bg-[#001226]/60 relative">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase">
                Module_04 // System_Level
            </div>

            <h3 class="text-center text-2xl font-black mb-10 tracking-[0.4em] text-white uppercase">
                // Ranking Hierarchy
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                {
                    [
                        {
                            lvl: "0x01",
                            name: "Explorer",
                            focus: "Dasar & Tools",
                            details: {
                                focus: "Mempelajari dasar-dasar teknologi (coding, elektronika, dll) dan mengenal tools club.",
                                activity: "Mengikuti kegiatan pembelajaran secara aktif.",
                                competition: "Hanya Kompetisi Internal untuk melatih mental dan dasar teknis.",
                                promotion: "Lulus Ujian Teori 'Basic Of Tech 101' dengan nilai >78%.",
                            },
                        },
                        {
                            lvl: "0x02",
                            name: "Builder",
                            focus: "Mini Projects",
                            details: {
                                focus: "Mengerjakan mini project sesuai arahan dan memahami alur pembuatan proyek.",
                                activity: "Mengikuti latihan rutin dan menyelesaikan task dengan baik.",
                                competition: "Kompetisi Tingkat Lokal/Regional (antar sekolah atau tingkat kota).",
                                promotion: "Berhasil menyelesaikan Latihan Rutin selama 2 bulan.",
                            },
                        },
                        {
                            lvl: "0x03",
                            name: "Engineer",
                            focus: "Advanced Systems",
                            details: {
                                focus: "Upgrade project kompleks dan menggabungkan konsep software & hardware.",
                                activity: "Problem solving mandiri dalam pengerjaan project.",
                                competition: "Kompetisi Tingkat Provinsi atau Undangan Khusus.",
                                promotion: "Lulus Ujian Lisan 'Advanced Tech 101'.",
                            },
                        },
                        {
                            lvl: "0x04",
                            name: "Inventor",
                            focus: "Original Innovation",
                            details: {
                                focus: "Menciptakan proyek orisinal yang inovatif dan siap lomba.",
                                activity: "Membimbing anggota level di bawahnya (menjadi mentor).",
                                competition: "Garda terdepan untuk Kompetisi Tingkat Nasional dan Internasional.",
                                promotion: "Menjadi perwakilan utama klub dalam ajang-ajang bergengsi.",
                            },
                        },
                    ].map((rank) => (
                        <div
                            class="level-card border border-[#00f2ff]/20 p-6 bg-[#001226] hover:border-[#00f2ff] transition-all group cursor-pointer relative overflow-hidden"
                            data-lvl={rank.lvl}
                            data-name={rank.name}
                            data-focus={rank.details.focus}
                            data-activity={rank.details.activity}
                            data-comp={rank.details.competition}
                            data-promo={rank.details.promotion}
                        >
                            <div class="absolute top-0 right-0 p-2 text-[8px] text-[#00f2ff] opacity-0 group-hover:opacity-40 transition-opacity uppercase tracking-widest">
                                Click to Decrypt
                            </div>
                            <div class="text-4xl font-black text-[#00f2ff]/10 mb-2 group-hover:text-[#00f2ff]/30 transition-colors">
                                {rank.lvl}
                            </div>
                            <div class="text-xl font-bold text-white mb-4 uppercase tracking-tighter group-hover:text-[#00f2ff] transition-colors">
                                {rank.name}
                            </div>
                            <div class="border-t border-[#00f2ff]/10 pt-4">
                                <div class="text-[8px] opacity-40 uppercase tracking-widest mb-1">
                                    Primary Focus
                                </div>
                                <div class="text-[11px] text-[#00f2ff] uppercase">
                                    {rank.focus}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- Module 05: Operational Protocols -->
    <div class="lg:col-span-8">
        <div class="border border-[#00f2ff]/30 p-8 bg-[#001226]/60 relative h-full">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase">
                Module_05 // Operational_Protocols
            </div>
            <h3 class="text-xs font-bold mb-6 mt-4 text-[#00f2ff] tracking-widest uppercase">
                // Teknis & Sistem Pembelajaran
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                {
                    [
                        { t: "Theory Session", d: "Penyampaian konsep coding, elektronika, & problem solving." },
                        { t: "Hands-on Session", d: "Praktik langsung melalui mini project atau eksperimen." },
                        { t: "Tech Sharing", d: "Sesi berbagi tools, teknologi baru, & pengalaman antar anggota." },
                    ].map((item) => (
                        <div class="p-4 bg-[#00f2ff]/5 border border-[#00f2ff]/10">
                            <div class="text-[10px] font-bold text-white mb-2 uppercase">
                                {item.t}
                            </div>
                            <p class="text-[9px] text-gray-400 leading-relaxed">
                                {item.d}
                            </p>
                        </div>
                    ))
                }
            </div>
            <div class="space-y-6">
                <div class="border-t border-[#00f2ff]/10 pt-4">
                    <div class="text-[10px] font-bold text-[#00f2ff] mb-4 uppercase tracking-widest">
                        Weekly Deployment Flow
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-[#00f2ff]/5 p-4 border-l-2 border-[#00f2ff]">
                            <div class="text-[11px] font-bold text-white mb-1">MINGGU GANJIL</div>
                            <div class="text-[10px] text-gray-400 italic">Core Materials + Basic Practice</div>
                        </div>
                        <div class="bg-[#00f2ff]/5 p-4 border-l-2 border-[#00f2ff]">
                            <div class="text-[11px] font-bold text-white mb-1">MINGGU GENAP</div>
                            <div class="text-[10px] text-gray-400 italic">Tech Sharing + Routine Training + Evaluation</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Module 09: Tech Stack & Tools -->
    <div class="lg:col-span-4">
        <div class="border border-[#00f2ff]/30 p-8 bg-[#001226]/60 relative h-full">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase">
                Module_09 // Tech_Stack
            </div>
            <h3 class="text-xs font-bold mb-6 mt-4 text-[#00f2ff] tracking-widest uppercase">Hardware & Software</h3>
            <div class="space-y-6">
                <div>
                    <div class="text-[9px] opacity-40 uppercase mb-2 tracking-widest">Hardware Layer</div>
                    <div class="flex flex-wrap gap-2">
                        {["Arduino", "ESP32", "Sensors", "Automation"].map((tag) => (
                            <span class="px-2 py-1 bg-[#00f2ff]/10 border border-[#00f2ff]/20 text-[9px] text-[#00f2ff] font-mono">{tag}</span>
                        ))}
                    </div>
                </div>
                <div>
                    <div class="text-[9px] opacity-40 uppercase mb-2 tracking-widest">Logic Layer</div>
                    <div class="flex flex-wrap gap-2">
                        {["Python", "C++", "JavaScript", "HTML/CSS"].map((tag) => (
                            <span class="px-2 py-1 bg-[#00f2ff]/10 border border-[#00f2ff]/20 text-[9px] text-white font-mono">{tag}</span>
                        ))}
                    </div>
                </div>
                <div>
                    <div class="text-[9px] opacity-40 uppercase mb-2 tracking-widest">Platform & Tools</div>
                    <div class="flex flex-wrap gap-2">
                        {["VS Code", "Arduino IDE", "Figma", "Canva"].map((tag) => (
                            <span class="px-2 py-1 border border-[#00f2ff]/30 text-[9px] text-gray-400 font-mono italic">{tag}</span>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Module 10: Performance Metrics -->
    <div class="lg:col-span-6">
        <div class="border border-[#00f2ff]/30 p-8 bg-[#001226]/60 relative h-full">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase">
                Module_10 // Success_Metrics
            </div>
            <h3 class="text-xs font-bold mb-6 mt-4 text-[#00f2ff] tracking-widest uppercase">// Indikator Keberhasilan</h3>
            <div class="space-y-4">
                {
                    [
                        { t: "Productivity", d: "Jumlah proyek inovatif yang dihasilkan anggota." },
                        { t: "Engagement", d: "Tingkat keaktifan anggota dalam sesi rutin." },
                        { t: "Competitiveness", d: "Partisipasi dan prestasi dalam lomba IT." },
                        { t: "Contribution", d: "Kontribusi nyata dalam ICT Show sekolah." },
                    ].map((metric) => (
                        <div class="flex items-start gap-4 p-3 border border-[#00f2ff]/5 hover:bg-[#00f2ff]/5 transition-colors">
                            <div class="w-1 h-10 bg-[#00f2ff]/30" />
                            <div>
                                <div class="text-[10px] font-black text-white uppercase">{metric.t}</div>
                                <p class="text-[9px] text-gray-500">{metric.d}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- Module 06: Commitments & Values -->
    <div class="lg:col-span-6">
        <div class="border border-[#00f2ff]/30 p-8 bg-[#00f2ff]/5 relative h-full">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase">
                Module_06 // Values
            </div>
            <div class="space-y-6 mt-4">
                <div>
                    <h4 class="text-xs font-bold text-white mb-2 uppercase tracking-widest border-b border-[#00f2ff]/20 pb-1">Dwi Sumpah</h4>
                    <p class="text-[10px] text-gray-400 leading-relaxed">
                        Setiap anggota The Tinkers berkomitmen untuk terus <span class="text-white">belajar dan berkembang</span> tanpa henti, serta memanfaatkan <span class="text-white">teknologi secara bijak</span> demi kebaikan bersama.
                    </p>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-white mb-2 uppercase tracking-widest border-b border-[#00f2ff]/20 pb-1">Tri Rachana</h4>
                    <p class="text-[10px] text-gray-400 leading-relaxed">
                        Club ini dibangun di atas tiga pilar utama: <span class="text-[#00f2ff] font-bold">Eksplorasi</span> — keberanian untuk mencoba hal baru; <span class="text-[#00f2ff] font-bold">Inovasi</span> — kemampuan mengubah ide menjadi solusi nyata; dan <span class="text-[#00f2ff] font-bold">Kolaborasi</span> — kekuatan yang lahir dari kerja tim.
                    </p>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-white mb-2 uppercase tracking-widest border-b border-[#00f2ff]/20 pb-1">Panca Dasar</h4>
                    <p class="text-[10px] text-gray-400 leading-relaxed">
                        Lima nilai fundamental yang menjadi pondasi setiap anggota: <span class="text-white">Disiplin</span> dalam berlatih, <span class="text-white">Kreativitas</span> dalam berkarya, <span class="text-white">Tanggung Jawab</span> dalam setiap tugas, <span class="text-white">Kerja Sama</span> dalam satu tim, dan <span class="text-white">Etika Teknologi</span> sebagai kompas moral.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Module 07: Know More About Us -->
    <div class="lg:col-span-12">
        <div class="border border-[#00f2ff]/30 p-8 bg-[#001226]/60 relative flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase tracking-widest">
                Module_07 // External_Link
            </div>

            <!-- Left: Label -->
            <div class="mt-4 md:mt-0">
                <div class="text-[9px] text-[#00f2ff]/40 uppercase tracking-[0.4em] font-bold mb-2">Get To Know More About Us</div>
                <p class="text-gray-400 text-xs max-w-sm leading-relaxed">
                    Follow our Instagram to stay up to date with The Tinkers' latest projects, competitions, and tech activities.
                </p>
            </div>

            <!-- Right: Instagram Button -->
            <a
                href="https://instagram.com/the_tinkers.abbs"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 border border-[#00f2ff]/30 hover:border-[#00f2ff] bg-[#00f2ff]/5 hover:bg-[#00f2ff]/10 px-8 py-4 transition-all duration-300 hover:shadow-[0_0_20px_rgba(0,242,255,0.15)] shrink-0"
            >
                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-purple-600 via-pink-500 to-yellow-400 flex items-center justify-center shadow-lg shrink-0">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                </div>
                <div>
                    <div class="text-[9px] text-[#00f2ff]/50 uppercase tracking-[0.3em] font-bold mb-0.5">Instagram</div>
                    <div class="text-white font-bold text-sm group-hover:text-[#00f2ff] transition-colors font-mono">@the_tinkers.abbs</div>
                </div>
                <svg class="w-4 h-4 text-[#00f2ff]/30 group-hover:text-[#00f2ff] ml-2 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
            </a>
        </div>
    </div>
</div>

---
import type { TinkersProject } from '../../types/sanity';

interface Props {
  projects?: TinkersProject[];
}

const { projects } = Astro.props;

const displayProjects = projects && projects.length > 0 ? projects : [];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto py-12 px-4">
    {displayProjects.length > 0 ? (
        displayProjects.map((project, index) => (
            <div class="project-card border border-[#00f2ff]/30 p-8 bg-[#001226]/60 backdrop-blur-md relative hover:border-[#00f2ff] transition-all group overflow-hidden flex flex-col">
                <!-- HUD Elements inside card -->
                <div class="absolute top-0 right-0 p-3 text-[8px] text-[#00f2ff] opacity-40 font-mono">
                    PRJ-{String(index + 1).padStart(3, '0')}
                </div>
                
                <div class="mb-6">
                    <div class="text-[9px] text-[#00f2ff] opacity-50 uppercase tracking-[0.3em] mb-2">
                        {project.type === 'kurikulum' ? 'Academic_Assignment' : 'Personal_Innovation'}
                    </div>
                    <h3 class="text-2xl font-black italic text-white uppercase group-hover:text-[#00f2ff] transition-colors leading-tight">
                        {project.projectName}
                    </h3>
                    <div class="text-[10px] text-gray-400 mt-1 uppercase tracking-widest">
                        Creator: {project.studentName} ({project.class})
                    </div>
                </div>

                <div class="border-l-2 border-[#00f2ff]/30 pl-4 mb-6">
                    <p class="text-sm text-gray-300 leading-relaxed italic">
                        "{project.description}"
                    </p>
                </div>

                <div class="flex flex-wrap gap-2 mb-8">
                    {project.tags?.map(tag => (
                        <span class="px-2 py-1 bg-[#00f2ff]/10 border border-[#00f2ff]/30 text-[9px] text-[#00f2ff] font-mono">
                            {tag}
                        </span>
                    ))}
                </div>

                <div class="flex items-center justify-between border-t border-[#00f2ff]/10 pt-4 mt-auto">
                    <div class="flex items-center gap-2">
                        <span class={`w-2 h-2 rounded-full ${project.status === 'Completed' ? 'bg-green-500' : 'bg-yellow-500'} animate-pulse`}></span>
                        <span class="text-[10px] font-bold text-white/60 uppercase">{project.status || 'Active'}</span>
                    </div>
                    {project.docLink && (
                        <a 
                            href={project.docLink} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="text-[10px] text-[#00f2ff] hover:underline font-bold uppercase tracking-widest"
                        >
                            Access Data >
                        </a>
                    )}
                </div>

                <!-- Decorative Scanning line for card -->
                <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#00f2ff] to-transparent translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
            </div>
        ))
    ) : (
        <div class="col-span-full py-20 text-center border border-[#00f2ff]/20 bg-[#001226]/40 backdrop-blur-md">
            <div class="text-[#00f2ff] opacity-50 font-mono text-xs uppercase tracking-[0.5em] mb-4">No data available in core</div>
            <h3 class="text-3xl font-black italic text-white/20 uppercase">Waiting for transmissions...</h3>
        </div>
    )}
</div>

<style>
    .project-card {
        box-shadow: inset 0 0 30px rgba(0, 242, 255, 0.05);
    }
    .project-card:hover {
        box-shadow: 0 0 30px rgba(0, 242, 255, 0.1), inset 0 0 30px rgba(0, 242, 255, 0.05);
    }
</style>

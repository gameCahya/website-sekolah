---
// src/pages/tentang.astro
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/cta/CTASection.astro";
import TeacherCarousel from "../components/tentang/TeacherCarousel.astro";
---

<Layout title="Tentang Kami - SMP ABBS Surakarta">
  <section class="pt-32 pb-20 text-center">
    <div class="max-w-7xl mx-auto px-6">
      <span class="font-hand text-xl text-accent-600 dark:text-accent-400 rotate-[-2deg] block mb-4">cerita kami dimulai di sini</span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6">
        Sejarah & <span class="font-serif font-normal italic text-primary-600 dark:text-primary-400">Visi Kami</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-600 dark:text-gray-400 max-w-3xl mx-auto">
        Membangun pondasi keunggulan sejak 2023 untuk mencetak generasi muslim global.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="font-hand text-lg text-primary-600 dark:text-primary-400 rotate-[-1deg] block mb-3">berawal dari sebuah mimpi</span>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-8">
            Warisan <span class="marker font-serif font-normal italic text-primary-600 dark:text-primary-400">Keunggulan</span>
          </h2>
          <div class="space-y-5 text-slate-600 dark:text-gray-400 leading-relaxed">
            <p class="drop-cap">SMP Al Abidin Bilingual Boarding School (ABBS) Surakarta didirikan pada tahun 2023 dengan visi menciptakan generasi muslim yang unggul dalam prestasi akademik, berakhlak mulia, dan mampu bersaing di tingkat global.</p>
            <p>Berawal dari keinginan untuk menyediakan pendidikan berkualitas yang memadukan kurikulum nasional dengan pendidikan agama Islam yang kuat, ABBS terus berkembang menjadi salah satu boarding school terkemuka di Surakarta.</p>
            <p>Dengan sistem bilingual, kami mempersiapkan siswa untuk menghadapi tantangan era globalisasi tanpa meninggalkan nilai-nilai keislaman yang menjadi akar karakter mereka.</p>
          </div>
        </div>
        <div>
          <div class="relative bg-white dark:bg-gray-900 rounded-2xl p-8 border border-slate-200/80 dark:border-gray-800 shadow-sm rotate-[1deg]">
            <span class="absolute -top-3 right-6 font-hand text-sm text-secondary-700 bg-accent-200 px-3 py-1 rounded-md rotate-[2deg] shadow-sm">angka-angka kami</span>
            <div class="space-y-8">
              {
                [
                  { year: "2023", label: "Tahun Berdiri", desc: "Awal perjalanan mencetak generasi cemerlang.", icon: "calendar" },
                  { year: "500+", label: "Siswa Aktif", desc: "Komunitas belajar yang dinamis dan kompetitif.", icon: "users" },
                  { year: "100+", label: "Prestasi Nasional", desc: "Rekam jejak juara di berbagai kompetisi.", icon: "star" },
                  { year: "A", label: "Akreditasi", desc: "Standar kualitas pendidikan tertinggi.", icon: "award" },
                ].map((item, i) => (
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center text-primary-600 dark:text-primary-400 shrink-0">
                      <i data-feather={item.icon} class="w-5 h-5" />
                    </div>
                    <div class="flex-1 flex items-center justify-between gap-4">
                      <div>
                        <div class="font-hand text-xl text-primary-600 dark:text-primary-400 rotate-[-1deg]">{item.label}</div>
                        <div class="text-sm text-slate-600 dark:text-gray-400">{item.desc}</div>
                      </div>
                      <div class="font-serif text-3xl font-semibold text-slate-900 dark:text-white">{item.year}</div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-20 bg-[#f8fafc] dark:bg-white/[0.03]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-8">
        <div class="relative bg-white dark:bg-gray-900 rounded-2xl p-8 border border-slate-200/80 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow duration-300">
          <span class="font-serif italic text-4xl text-primary-200 dark:text-primary-900 block mb-4">01</span>
          <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">Visi</h3>
          <p class="text-slate-600 dark:text-gray-400 leading-relaxed">
            Menjadi lembaga pendidikan Islam terdepan yang menghasilkan generasi muslim yang berilmu, berakhlak mulia, berprestasi, dan mampu berkomunikasi secara global dengan tetap berpegang teguh pada nilai-nilai keislaman.
          </p>
        </div>

        <div class="relative bg-white dark:bg-gray-900 rounded-2xl p-8 border border-slate-200/80 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow duration-300">
          <span class="font-serif italic text-4xl text-secondary-200 dark:text-secondary-900 block mb-4">02</span>
          <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">Misi</h3>
          <ul class="space-y-3">
            {
              [
                "Pendidikan berkualitas nasional & internasional",
                "Pembentukan karakter islami komprehensif",
                "Pengembangan kemampuan bilingual global",
                "Fasilitasi bakat & minat siswa secara optimal",
                "Lingkungan belajar kondusif & Islami",
              ].map((misi) => (
                <li class="flex items-start gap-3">
                  <div class="mt-1 w-4 h-4 rounded-full bg-secondary-100 dark:bg-secondary-900/30 flex items-center justify-center shrink-0">
                    <i data-feather="check" class="w-2.5 h-2.5 text-secondary-600 dark:text-secondary-400" />
                  </div>
                  <span class="text-slate-600 dark:text-gray-400">{misi}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="font-hand text-xl text-accent-600 dark:text-accent-400 rotate-[-2deg] block mb-3">ruang belajar yang menyenangkan</span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">
          Fasilitas <span class="font-serif font-normal italic text-primary-600 dark:text-primary-400">Terbaik</span>
        </h2>
        <p class="text-slate-600 dark:text-gray-400 max-w-2xl mx-auto">
          Mendukung ekosistem belajar yang modern, aman, dan nyaman.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          [
            { title: "Gedung Modern", desc: "Ruang kelas cerdas ber-AC & multimedia.", icon: "home" },
            { title: "Rooftop Arena", desc: "Area terbuka untuk kegiatan & festival.", icon: "sun" },
            { title: "Smart Library", desc: "Akses literasi digital & fisik lengkap.", icon: "book-open" },
            { title: "Health Cafe", desc: "Kantin sehat dengan nutrisi terjamin.", icon: "coffee" },
          ].map((item) => (
            <div class="p-6 bg-white dark:bg-gray-900 rounded-xl border border-slate-200/80 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow duration-300">
              <div class="w-12 h-12 bg-slate-50 dark:bg-gray-800 rounded-xl flex items-center justify-center text-slate-500 mb-4">
                <i data-feather={item.icon} class="w-5 h-5" />
              </div>
              <h4 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white mb-2">{item.title}</h4>
              <p class="text-slate-600 dark:text-gray-400 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div>
    <TeacherCarousel />
  </div>

  <CTASection
    id="kontak-cta"
    title="Bergabunglah dengan Keluarga ABBS"
    description="Jadilah bagian dari generasi unggul yang siap menghadapi tantangan masa depan"
    primaryButton={{
      text: "Chat WhatsApp",
      href: "/kontak",
      icon: "message-circle",
    }}
    secondaryButton={{
      text: "Lihat Program",
      href: "/program",
      icon: "book",
    }}
  />
</Layout>

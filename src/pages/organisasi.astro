---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/cta/CTASection.astro";

const organisasi = [
  {
    name: "OSSAKA",
    id: "osis",
    logo: "/communities/ossaka.png",
    description: "OSIS SMP ABBS Surakarta. Wadah aspirasi dan pengembangan diri siswa dalam berorganisasi.",
    link: "/organisasi/ossaka",
    color: "from-yellow-400 to-yellow-600",
    features: ["Kepemimpinan", "Manajemen Event", "Aspirasi Siswa"]
  },
  {
    name: "Meca Knights",
    id: "pmr",
    logo: "/communities/meca_knight.png",
    description: "Medical ABBS Knight. Palang Merah Remaja yang berfokus pada kemanusiaan, kesehatan, dan kesiapsiagaan bencana.",
    link: "/organisasi/meca_knights",
    color: "from-red-400 to-red-600",
    features: ["Pertolongan Pertama", "Kesehatan Remaja", "Donor Darah"]
  },
  {
    name: "PRASSAKA",
    id: "dg",
    logo: "/communities/prasaka.png",
    description: "Pramuka SMP ABBS Surakarta. Membentuk karakter mandiri, disiplin, dan cinta alam melalui kegiatan kepramukaan.",
    link: "/organisasi/prasaka",
    color: "from-emerald-400 to-emerald-600",
    features: ["Kepramukaan", "Survival Skills", "Character Building"]
  },
  {
    name: "SINAPS",
    id: "sinaps",
    logo: "/communities/sinaps.png",
    description: "Scientific and Intellectual Squad. Organisasi yang berfokus pada persiapan Olimpiade Sains Nasional (OSN) dan pengembangan intelektual siswa.",
    link: "/organisasi/sinaps_osn",
    color: "from-indigo-400 to-indigo-600",
    features: ["Matematika", "IPA", "IPS"]
  },
];
---

<Layout title="Organisasi - SMP ABBS Surakarta">
    <!-- Hero Header -->
    <section class="pt-40 pb-24 relative overflow-hidden text-center bg-cream-50 dark:bg-gray-950">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 opacity-40">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[120%] h-[120%] bg-primary-500/5 blur-[120px] rounded-full"></div>
        </div>
        <div class="max-w-7xl mx-auto px-6 reveal">
            <span class="inline-block px-4 py-1 mb-6 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 text-sm font-bold tracking-widest uppercase">
                Student Life
            </span>
            <h1 class="text-6xl md:text-8xl font-[900] text-gray-900 dark:text-white mb-8 tracking-tighter leading-[0.8]">
                Organisasi <span class="text-primary-600 dark:text-primary-400">Siswa.</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto font-light leading-relaxed">
                Temukan tempatmu untuk berkembang, berkarya, dan menjalin persahabatan di ekosistem organisasi kami.
            </p>
        </div>
    </section>

    <!-- Organisasi Section -->
    <section class="py-24 relative bg-white dark:bg-[#0a0a0a]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16 reveal">
                <h2 class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white mb-4 tracking-tight">
                    Organisasi
                </h2>
                <p class="text-gray-500 dark:text-gray-400 text-lg font-light max-w-xl mx-auto">
                    Wadah pengembangan diri dan kepemimpinan bagi siswa SMP ABBS Surakarta.
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-10">
                {organisasi.map((org, index) => (
                    <div class="group relative reveal" style={`transition-delay: ${index * 100}ms`}>
                        <div class="relative bg-white dark:bg-gray-900/40 backdrop-blur-sm border border-gray-100 dark:border-gray-800 rounded-[2.5rem] p-8 md:p-10 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 flex flex-col md:flex-row gap-6 items-center md:items-start text-center md:text-left">
                            
                            <!-- Logo Wrapper -->
                            <div class={`w-20 h-20 md:w-28 md:h-28 rounded-[1.5rem] overflow-hidden shadow-lg bg-gradient-to-br ${org.color} p-0.5 shrink-0`}>
                                <div class="w-full h-full bg-white dark:bg-gray-950 rounded-[calc(1.5rem-2px)] flex items-center justify-center p-3">
                                    <img 
                                        src={org.logo} 
                                        alt={org.name}
                                        class={`w-full h-full object-contain ${org.invert ? 'dark:invert' : ''}`}
                                    />
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="flex-1">
                                <div class="mb-2 flex justify-center md:justify-start">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-extrabold bg-primary-500/10 text-primary-600 dark:text-primary-400 border border-primary-500/20 tracking-wider uppercase">
                                        <span class="relative flex h-1.5 w-1.5">
                                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
                                            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary-500"></span>
                                        </span>
                                        ONLINE
                                    </span>
                                </div>
                                <h3 class="text-2xl font-black text-gray-900 dark:text-white mb-3 tracking-tight">
                                    {org.name}
                                </h3>
                                <p class="text-gray-500 dark:text-gray-400 font-light leading-relaxed mb-5 text-sm">
                                    {org.description}
                                </p>
                                <div class="flex flex-wrap gap-1.5 mb-6 justify-center md:justify-start">
                                    {org.features.map((feature) => (
                                        <span class="px-2.5 py-0.5 bg-gray-50 dark:bg-gray-800 rounded-md text-[9px] font-bold text-gray-400 uppercase tracking-widest border border-gray-100 dark:border-gray-700">
                                            {feature}
                                        </span>
                                    ))}
                                </div>
                                <a 
                                    href={org.link}
                                    class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-bold text-sm hover:gap-3 transition-all"
                                >
                                    Pelajari Selengkapnya
                                    <i data-feather="arrow-right" class="w-4 h-4"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Join Section -->
    <CTASection 
        title="Siap Bergabung?"
        description="Jadilah bagian dari organisasi kami dan kembangkan bakatmu bersama teman-teman yang hebat."
        primaryButton={{ text: 'Hubungi Pembina', href: '/kontak', icon: 'phone' }}
    />
</Layout>
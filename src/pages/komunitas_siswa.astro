---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/cta/CTASection.astro";

const communities = [
  {
    name: "OSSAKA",
    id: "osis",
    logo: "/communities/ossaka.png",
    description: "OSIS SMP ABBS Surakarta. Wadah aspirasi dan pengembangan diri siswa dalam berorganisasi.",
    link: "/komunitas/ossaka",
    color: "from-yellow-400 to-yellow-600",
    features: ["Kepemimpinan", "Manajemen Event", "Aspirasi Siswa"]
  },
  {
    name: "Meca Knights",
    id: "pmr",
    logo: "/communities/meca_knight.png",
    description: "Medical ABBS Knight. Palang Merah Remaja yang berfokus pada kemanusiaan, kesehatan, dan kesiapsiagaan bencana.",
    link: "/komunitas/meca_knights",
    color: "from-red-400 to-red-600",
    features: ["Pertolongan Pertama", "Kesehatan Remaja", "Donor Darah"]
  },
  {
    name: "PRASSAKA",
    id: "dg",
    logo: "/communities/prasaka.png",
    description: "Pramuka SMP ABBS Surakarta. Membentuk karakter mandiri, disiplin, dan cinta alam melalui kegiatan kepramukaan.",
    link: "/komunitas/prasaka",
    color: "from-emerald-400 to-emerald-600",
    features: ["Kepramukaan", "Survival Skills", "Character Building"]
  },
  {
    name: "The Tinkers",
    id: "tinkers",
    logo: "/communities/the_tinkers.png",
    description: "Komunitas teknologi dan inovasi. Tempat berkumpulnya para inovator muda di bidang IT dan robotik.",
    link: "/komunitas/the_tinkers",
    color: "from-sky-400 to-sky-600",
    features: ["Coding", "Robotics", "Innovation Lab"],
    invert: true
  },
  {
    name: "SINAPS",
    id: "sinaps",
    logo: "/communities/sinaps.png",
    description: "Scientific and Intellectual Squad. Komunitas yang berfokus pada persiapan Olimpiade Sains Nasional (OSN) dan pengembangan intelektual siswa.",
    link: "/komunitas/sinaps_osn",
    color: "from-indigo-400 to-indigo-600",
    features: ["Matematika", "IPA", "IPS"]
  },
];
---

<Layout title="Komunitas Siswa - SMP ABBS Surakarta">
    <section class="pt-40 pb-24 text-center bg-[#f8fafc] dark:bg-gray-950">
        <div class="max-w-7xl mx-auto px-6">
            <span class="inline-block px-3 py-1 mb-5 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 text-xs font-semibold tracking-wider uppercase">
                Student Life
            </span>
            <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6 leading-tight">
                Komunitas <span class="font-serif font-normal italic text-primary-600 dark:text-primary-400">Siswa.</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-600 dark:text-gray-400 max-w-2xl mx-auto">
                Temukan tempatmu untuk berkembang, berkarya, dan menjalin persahabatan di ekosistem komunitas kami.
            </p>
            <span class="font-hand text-xl text-accent-600 dark:text-accent-400 rotate-[-2deg] block mt-6">pilih yang paling seru buatmu!</span>
        </div>
    </section>

    <section class="py-12 md:py-20">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-2 gap-6">
                {communities.map((community) => (
                    <div class="bg-white dark:bg-gray-900 rounded-xl border border-slate-200/80 dark:border-gray-800 p-6 md:p-8 flex flex-col md:flex-row gap-6 items-center md:items-start text-center md:text-left shadow-sm hover:shadow-md transition-shadow duration-300">
                        <div class="w-20 h-20 rounded-2xl overflow-hidden bg-gradient-to-br p-0.5 shrink-0">
                            <div class="w-full h-full bg-white dark:bg-gray-950 rounded-[calc(1rem-2px)] flex items-center justify-center p-3">
                                <img 
                                    src={community.logo} 
                                    alt={community.name}
                                    class={`w-full h-full object-contain ${community.invert ? 'dark:invert' : ''}`}
                                />
                            </div>
                        </div>

                        <div class="flex-1">
                            <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white mb-2">{community.name}</h3>
                            <p class="text-slate-600 dark:text-gray-400 text-sm leading-relaxed mb-4">{community.description}</p>
                            <div class="flex flex-wrap gap-1.5 mb-4 justify-center md:justify-start">
                                {community.features.map((feature) => (
                                    <span class="px-2.5 py-0.5 bg-slate-50 dark:bg-gray-800 rounded-md text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                        {feature}
                                    </span>
                                ))}
                            </div>
                            <a 
                                href={community.link}
                                class="text-sm font-semibold text-primary-600 dark:text-primary-400"
                            >
                                Pelajari Selengkapnya &rarr;
                            </a>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <CTASection 
        title="Siap Bergabung?"
        description="Jadilah bagian dari komunitas kami dan kembangkan bakatmu bersama teman-teman yang hebat."
        primaryButton={{ text: 'Hubungi Pembina', href: '/kontak' }}
    />
</Layout>

---
// src/pages/organisasi/prasaka.astro
import Layout from "../../layouts/Layout.astro";
import PrasakaBackground from "../../components/prasaka/PrasakaBackground.astro";
import PrasakaHero from "../../components/prasaka/PrasakaHero.astro";
import PrasakaTriSatya from "../../components/prasaka/PrasakaTriSatya.astro";
import PrasakaDasaDarma from "../../components/prasaka/PrasakaDasaDarma.astro";
---

<Layout title="Dewan Galang PRASSAKA - Pramuka SMP ABBS Surakarta">
    <div class="prasaka-wrapper relative min-h-screen overflow-x-hidden bg-[#1a120b] text-[#c3b091] selection:bg-[#8b6914]/30">
        <!-- Adventure Logbook Background -->
        <PrasakaBackground />

        <!-- Content -->
        <div class="relative z-10 max-w-6xl mx-auto px-6 pt-32 pb-24">
            <PrasakaHero />
            <PrasakaTriSatya />
            <PrasakaDasaDarma />

            <!-- Get To Know More -->
            <section class="flex flex-col md:flex-row items-center justify-between gap-8 reveal">
                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="h-px w-10 rope-divider"></div>
                        <p class="text-[10px] font-bold text-[#8b6914]/50 uppercase tracking-[0.4em]" style="font-family: 'Courier New', monospace;">Get To Know More</p>
                        <div class="h-px w-10 rope-divider"></div>
                    </div>
                    <p class="text-[#c3b091]/30 text-xs max-w-sm leading-relaxed" style="font-family: 'Courier New', monospace;">
                        Ikuti Instagram Dewan Galang PRASSAKA untuk kabar kegiatan, latihan, dan petualangan Pramuka SMP ABBS Surakarta.
                    </p>
                </div>
                <a
                    href="https://instagram.com/dewangalang_prasaka"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-4 glass-card-prasaka px-7 py-4 rounded-2xl border border-[#8b6914]/20 hover:border-[#8b6914]/50 hover:shadow-[0_0_30px_rgba(139,105,20,0.15)] transition-all duration-500 hover:scale-[1.02] shrink-0"
                >
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#5a7247] to-[#3d5a2c] flex items-center justify-center shadow-lg shadow-[#5a7247]/20 shrink-0 border border-[#c4a77d]/20">
                        <svg class="w-5 h-5 text-[#c4a77d]" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] text-[#8b6914]/50 uppercase tracking-[0.3em] font-bold mb-0.5" style="font-family: 'Courier New', monospace;">Instagram</p>
                        <p class="text-[#c3b091] font-bold text-sm group-hover:text-[#c4a77d] transition-colors">@dewangalang_prasaka</p>
                    </div>
                    <svg class="w-4 h-4 text-[#8b6914]/30 group-hover:text-[#8b6914] ml-1 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                </a>
            </section>
        </div>
    </div>
</Layout>

<style is:global>
    @import "@fontsource/outfit/700.css";
    @import "@fontsource/inter/300.css";
    @import "@fontsource/inter/400.css";
    @import "@fontsource/inter/700.css";
    @import "@fontsource/inter/900.css";

    main {
        padding: 0 !important;
    }
</style>

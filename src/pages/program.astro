---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/cta/CTASection.astro';

const programs = [
  {
    id: 'ict',
    title: 'Program ICT',
    icon: 'cpu',
    description: 'Program teknologi komputer yang mengajarkan siswa tentang perangkat keras, perangkat lunak, jaringan, dan literasi digital.',
    features: [
      'Dasar perangkat keras dan sistem operasi',
      'Pemrograman dan aplikasi produktivitas',
      'Jaringan komputer dan keamanan dasar',
      'Proyek praktis berbasis teknologi'
    ],
    borderColor: 'border-primary-500',
    gradientFrom: 'from-primary-500',
    gradientTo: 'to-primary-600'
  },
  {
    id: 'tcp',
    title: 'Program TCP',
    icon: 'book',
    description: 'Program Tahfidz khusus yang menguatkan kemampuan menghafal Al-Qur\'an dan mendidik karakter Islami siswa.',
    features: [
      'Metode hafalan sistematis dan terstruktur',
      'Murojaah rutin setiap hari',
      'Pendampingan oleh pengajar tahfidz berpengalaman',
      'Wisuda tahfidz dan evaluasi berkala'
    ],
    borderColor: 'border-secondary-500',
    gradientFrom: 'from-secondary-500',
    gradientTo: 'to-secondary-600'
  }
];
---

<Layout title="Program - SMP ABBS Surakarta">
  <section class="pt-32 pb-20 text-center">
    <div class="max-w-7xl mx-auto px-6">
      <span class="font-hand text-xl text-accent-600 dark:text-accent-400 rotate-[-2deg] block mb-4">dua program andalan kami</span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6">
        Program <span class="font-serif font-normal italic text-primary-600 dark:text-primary-400">Unggulan</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-600 dark:text-gray-400 max-w-3xl mx-auto">
        Dirancang khusus untuk membangun kompetensi global dan karakter Islami yang kokoh.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {programs.map((program, i) => (
          <div class="relative bg-white dark:bg-gray-900 rounded-xl p-8 border border-slate-200/80 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow duration-300">
            <span class="absolute top-6 right-7 font-serif italic text-4xl text-slate-600 dark:text-slate-400">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center text-white mb-5">
              <i data-feather={program.icon} class="w-5 h-5"></i>
            </div>

            <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white mb-3">{program.title}</h3>
            <p class="text-slate-600 dark:text-gray-400 mb-6 leading-relaxed text-sm">{program.description}</p>
            <ul class="space-y-3">
              {program.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <div class="mt-0.5 w-3.5 h-3.5 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center shrink-0">
                    <i data-feather="check" class="w-2 h-2 text-primary-600 dark:text-primary-400"></i>
                  </div>
                  <span class="text-xs text-slate-600 dark:text-gray-400">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-20 bg-[#f8fafc] dark:bg-white/[0.03]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="font-hand text-xl text-accent-600 dark:text-accent-400 rotate-[-2deg] block mb-3">begini cara kami mengajar</span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">
          Metode <span class="font-serif font-normal italic text-primary-600 dark:text-primary-400">Pembelajaran</span>
        </h2>
        <p class="text-slate-600 dark:text-gray-400 max-w-2xl mx-auto">
          Pendekatan inovatif yang memastikan setiap siswa mencapai potensi terbaiknya.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { title: "STEM Education", desc: "Pembelajaran terpadu sains, teknologi, engineering, dan matematika yang menumbuhkan kreativitas dan keterampilan abad 21.", icon: "cpu" },
          { title: "Leadership Development", desc: "Penguatan kepemimpinan melalui praktik organisasi, kerja tim, dan manajemen proyek nyata.", icon: "briefcase" },
          { title: "Tahfidz", desc: "Pembiasaan hafalan Al-Qur'an dan penguatan karakter Islami sebagai dasar pembelajaran holistik.", icon: "book" },
          { title: "Ekstrakurikuler", desc: "Aktivitas tambahan untuk mengembangkan bakat, minat, dan soft skill siswa di berbagai bidang.", icon: "zap" }
        ].map((item) => (
          <div class="p-6 bg-white dark:bg-gray-900 rounded-xl border border-slate-200/80 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow duration-300">
            <div class="w-12 h-12 bg-slate-50 dark:bg-gray-800 rounded-xl flex items-center justify-center text-slate-500 mb-4">
              <i data-feather={item.icon} class="w-5 h-5"></i>
            </div>
            <h4 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white mb-2">{item.title}</h4>
            <p class="text-slate-600 dark:text-gray-400 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection 
    id="kontak-cta"
    title="Tertarik dengan Program Kami?"
    description="Daftarkan putra-putri Anda sekarang dan berikan pendidikan terbaik untuk masa depan mereka"
    primaryButton={{ text: 'Hubungi Kami', href: '/kontak' }}
    secondaryButton={{ text: 'Pelajari Lebih Lanjut', href: '/program' }}
  />
</Layout>

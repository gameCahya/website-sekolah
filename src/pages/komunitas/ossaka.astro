---
// src/pages/komunitas/ossaka.astro
import Layout from "../../layouts/Layout.astro";
import OssakaBackground from "../../components/ossaka/OssakaBackground.astro";
import OssakaHero from "../../components/ossaka/OssakaHero.astro";
import OssakaVisi from "../../components/ossaka/OssakaVisi.astro";
import OssakaMisi from "../../components/ossaka/OssakaMisi.astro";
---

<Layout title="OSSAKA - OSIS SMP ABBS Surakarta">
    <div class="ossaka-wrapper relative min-h-screen overflow-x-hidden bg-[#0a0814] text-indigo-100 selection:bg-indigo-500/30">
        <style is:global>
            .ossaka-wrapper { color: #c8c0e8; }
            /* Hide default scrollbar on misi horizontal */
            .misi-scroll::-webkit-scrollbar { height: 4px; }
            .misi-scroll::-webkit-scrollbar-track { background: rgba(99,102,241,0.05); border-radius: 4px; }
            .misi-scroll::-webkit-scrollbar-thumb { background: rgba(199,175,121,0.2); border-radius: 4px; }
            .misi-scroll::-webkit-scrollbar-thumb:hover { background: rgba(199,175,121,0.4); }
        </style>
        <OssakaBackground />

        <div class="relative z-10">
            <!-- ===== FULL-BLEED HERO ===== -->
            <div class="relative min-h-screen flex items-center">
                <div class="w-full max-w-7xl mx-auto px-6 lg:px-10 pt-32 pb-20">
                    <div class="grid lg:grid-cols-[1fr_380px] gap-16 items-center">
                        <!-- Left: Hero text -->
                        <div>
                            <OssakaHero />
                        </div>
                        <!-- Right: Quick info card -->
                        <div class="hidden lg:block">
                            <div class="glass-card-ossaka celestial-glow rounded-2xl p-8 relative overflow-hidden">
                                <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-600/5 blur-[60px] rounded-full"></div>
                                <div class="absolute top-4 right-5">
                                    <span class="text-[9px] font-bold text-indigo-300/15 uppercase tracking-widest">Profil</span>
                                </div>
                                <div class="space-y-5 relative z-10">
                                    <div>
                                        <p class="text-[10px] text-indigo-300/20 uppercase tracking-[0.3em] font-bold mb-1">Singkatan</p>
                                        <p class="text-sm text-indigo-100/60 font-medium">Organisasi Siswa Intra Sekolah</p>
                                    </div>
                                    <div class="h-px bg-gradient-to-r from-transparent via-indigo-500/10 to-transparent"></div>
                                    <div>
                                        <p class="text-[10px] text-indigo-300/20 uppercase tracking-[0.3em] font-bold mb-1">Sekolah</p>
                                        <p class="text-sm text-indigo-100/60 font-medium">SMP ABBS Surakarta</p>
                                    </div>
                                    <div class="h-px bg-gradient-to-r from-transparent via-indigo-500/10 to-transparent"></div>
                                    <div>
                                        <p class="text-[10px] text-indigo-300/20 uppercase tracking-[0.3em] font-bold mb-1">Instagram</p>
                                        <p class="text-sm text-amber-300/60 font-medium">@osis.smpabbs</p>
                                    </div>
                                    <div class="h-px bg-gradient-to-r from-transparent via-indigo-500/10 to-transparent"></div>
                                    <div>
                                        <p class="text-[10px] text-indigo-300/20 uppercase tracking-[0.3em] font-bold mb-1">Status</p>
                                        <div class="flex items-center gap-2">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                            <p class="text-sm text-emerald-300/60 font-medium">Aktif</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== STATS BAR (full-width) ===== -->
            <div class="relative border-y border-indigo-500/5 bg-indigo-950/20 backdrop-blur-sm">
                <div class="max-w-7xl mx-auto px-6 lg:px-10 py-10">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                        {[
                            { value: "1945", label: "Tahun Berdiri OSIS", suffix: "" },
                            { value: "50", label: "Anggota Pengurus", suffix: "+" },
                            { value: "12", label: "Program Kerja / Tahun", suffix: "" },
                            { value: "100", label: "Menjadi Teladan", suffix: "%" },
                        ].map((stat, i) => (
                            <div class="text-center reveal" style={`transition-delay: ${i * 100}ms`}>
                                <p class="text-3xl md:text-4xl font-black text-gradient-executive mb-2">
                                    {stat.value}<span class="text-lg">{stat.suffix}</span>
                                </p>
                                <p class="text-[10px] text-indigo-300/25 uppercase tracking-[0.2em] font-bold">{stat.label}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- ===== VISI SECTION — full-bleed with side accent ===== -->
            <div class="relative">
                <!-- Left accent line -->
                <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-amber-500/10 to-transparent hidden lg:block" style="margin-left: calc((100vw - 80rem) / 2 + 2.5rem);"></div>
                <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
                    <OssakaVisi />
                </div>
            </div>

            <!-- ===== MISI SECTION — full-bleed horizontal scroll ===== -->
            <div class="relative border-t border-indigo-500/5">
                <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
                    <OssakaMisi />
                </div>
            </div>

            <!-- ===== INSTAGRAM CTA — full-width bar ===== -->
            <div class="relative border-t border-indigo-500/5 bg-indigo-950/30 backdrop-blur-sm">
                <div class="max-w-7xl mx-auto px-6 lg:px-10 py-12">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
                        <div>
                            <div class="flex items-center gap-3 mb-3">
                                <div class="h-px w-10 gold-line"></div>
                                <p class="text-[10px] font-bold text-indigo-300/20 uppercase tracking-[0.4em]">Get To Know More</p>
                                <div class="h-px w-10 gold-line"></div>
                            </div>
                            <p class="text-indigo-200/15 text-xs max-w-sm leading-relaxed">
                                Ikuti Instagram OSSAKA untuk kabar terbaru, kegiatan, dan aspirasi siswa SMP ABBS Surakarta.
                            </p>
                        </div>
                        <a
                            href="https://instagram.com/osis.smpabbs"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex items-center gap-4 glass-card-ossaka celestial-glow px-7 py-4 rounded-2xl border border-indigo-500/10 hover:border-amber-500/30 hover:shadow-[0_0_40px_rgba(199,175,121,0.08)] transition-all duration-500 hover:scale-[1.02] shrink-0"
                        >
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow-lg shadow-amber-500/15 shrink-0">
                                <svg class="w-5 h-5 text-[#0a0814]" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-[10px] text-indigo-300/20 uppercase tracking-[0.3em] font-bold mb-0.5">Instagram</p>
                                <p class="text-indigo-100/50 font-bold text-sm group-hover:text-amber-300/80 transition-colors">@osis.smpabbs</p>
                            </div>
                            <svg class="w-4 h-4 text-indigo-400/15 group-hover:text-amber-400/60 ml-1 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    @import "@fontsource/outfit/700.css";
    @import "@fontsource/inter/300.css";
    @import "@fontsource/inter/400.css";
    @import "@fontsource/inter/700.css";
    @import "@fontsource/inter/900.css";

    main { padding: 0 !important; }
</style>

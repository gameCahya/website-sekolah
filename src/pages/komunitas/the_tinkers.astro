---
import Layout from "../../layouts/Layout.astro";
import CrtBoot from "../../components/tinkers/CrtBoot.astro";
import BlueprintBoard from "../../components/tinkers/BlueprintBoard.astro";
---

<Layout title="The Tinkers - Futuristic HUD Schematic">
    <!-- Style to override Layout's header/footer -->
    <style is:global>
        main {
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Futuristic Blueprint Header Overwrite */
        header {
            background-color: rgba(0, 18, 38, 0.95) !important;
            backdrop-blur: 10px !important;
            border-bottom: 1px solid rgba(0, 242, 255, 0.3) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5) !important;
            transition: transform 0.5s ease, opacity 0.5s ease !important;
            z-index: 50 !important;
        }
        header.hide-header {
            transform: translateY(-100%) !important;
            opacity: 0 !important;
            pointer-events: none !important;
        }
        header nav a,
        header nav button {
            color: rgba(0, 242, 255, 0.7) !important;
            font-family: "JetBrains Mono", monospace !important;
            text-transform: uppercase !important;
            font-size: 10px !important;
            letter-spacing: 0.2em !important;
            transition: all 0.3s ease !important;
            padding: 0.5rem 1rem !important;
            position: relative !important;
        }
        header nav a:hover,
        header nav button:hover {
            color: white !important;
            background: rgba(0, 242, 255, 0.1) !important;
            text-shadow: 0 0 10px rgba(0, 242, 255, 0.8) !important;
        }
        header nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 0;
            height: 1px;
            background: #00f2ff;
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }
        header nav a:hover::after {
            width: 100%;
        }

        /* Futuristic Blueprint Footer Overwrite */
        footer {
            background-color: #001226 !important;
            border-top: 2px solid #00f2ff !important;
            color: #00f2ff !important;
            font-family: "JetBrains Mono", monospace !important;
            box-shadow: 0 0 20px rgba(0, 242, 255, 0.1) !important;
            margin-top: 0 !important;
        }
        footer h3,
        footer h4 {
            color: white !important;
            text-shadow: 0 0 10px #00f2ff !important;
            text-transform: uppercase !important;
            letter-spacing: 0.2em !important;
        }
        footer p,
        footer a,
        footer span {
            color: #a5d8ff !important;
            font-size: 11px !important;
        }
        footer a:hover {
            color: white !important;
            text-shadow: 0 0 5px #00f2ff !important;
        }
        footer .border-t {
            border-color: rgba(0, 242, 255, 0.2) !important;
        }

        /* Dim logos so they aren't too bright on dark BG */
        header img {
            opacity: 0.7;
            transition: opacity 0.3s ease;
        }
        header img:hover {
            opacity: 1;
        }
        footer img {
            opacity: 0.5;
            transition: opacity 0.3s ease;
        }
        footer img:hover {
            opacity: 1;
        }
    </style>

    <!-- Blueprint Board Component -->
    <BlueprintBoard />

    <!-- Boot Sequence Component -->
    <CrtBoot />
</Layout>

<style is:global>
    :global(body) {
        margin: 0;
        background-color: #001226; /* Deeper blue for futuristic feel */
        overflow: hidden;
        height: 100vh;
        width: 100vw;
        color: #00f2ff;
        cursor: crosshair; /* Techy cursor */
    }

    /* Shared CRT Effects */
    .crt-curvature {
        position: relative;
    }

    .crt-curvature::after {
        content: " ";
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        background:
            linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%),
            linear-gradient(
                90deg,
                rgba(255, 0, 0, 0.06),
                rgba(0, 255, 0, 0.02),
                rgba(0, 0, 255, 0.06)
            );
        z-index: 1000;
        background-size:
            100% 2px,
            3px 100%;
        pointer-events: none;
    }
</style>
